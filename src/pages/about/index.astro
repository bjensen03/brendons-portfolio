---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import { experience, textLink } from '../../components/home/data';
import { RESUME } from '../../components/footer/links';
import { showPlaceholders } from '../../lib/placeholders';

import portrait from '../../assets/about/portrait.webp';
import trekkers from '../../content/projects/images/twilight-trekkers/library/us/antelope-canyon-couple-01.webp';

/*
  About (the brief, 2026-10-25): approachable, organised, personal,
  and pitched at software engineering roles. Order: intro → experience →
  how I work → The Twilight Trekkers → education and certifications; the
  site footer that follows every page is the contact section.

  Same visual system as the rest of the site (Archivo display steps, Geist
  body, tan only as a fill), with two About-specific choices: every heading
  is sentence case at one size (normal-case on the display step), and body
  copy carries no entrance animation, so no paragraph is ever caught
  half-faded on the dark ground. Paragraphs are held to about 65ch.

  Facts only. The three long project breakdowns that used to sit here
  ("Not what it seemed") are each told in full in their case study's hard
  problem: rally-trailer.yaml (the LiteSpeed cache and stale nonces, 403s),
  all-in.yaml (the Shop guard reading shared server state), prolook.yaml
  (the stale compiled Blade template). How I work links to them.
*/

/* Experience: the verified roles, companies and dates the homepage used
   (experience() in components/home/data.ts, read from the case studies and
   the résumé). Each row gets one line from its study and one link. */
const roles = await experience();
const prolook = await getEntry('studies', 'prolook');
const ROLE_LINKS: Record<string, { href: string; label: string }> = {
  'Rally Trailer Manufacturing': { href: '/work/rally-trailer/', label: 'Rally Trailer case study' },
  'PROLOOK Sports': { href: '/work/prolook/', label: 'PROLOOK case study' },
  'Lincoln Academy': { href: '/work/lincoln-academy/', label: 'Lincoln Academy case study' },
  Freelance: { href: '/work/', label: 'All projects' },
};
/* Titles as his résumé gives them (2026-10-25), for About only;
   the case studies keep their own `role` wording. */
const RESUME_TITLES: Record<string, string> = {
  'Rally Trailer Manufacturing': 'Full-Stack Web Developer & Marketing Specialist',
  'PROLOOK Sports': 'Frontend Web Developer',
  'Lincoln Academy': 'Communications & Website Specialist',
  Freelance: 'Web Designer & Developer',
};
const EXPERIENCE = roles.map((r) => ({
  ...r,
  title: RESUME_TITLES[r.company] ?? r.title,
  line: r.company === 'PROLOOK Sports' && prolook ? prolook.data.label : r.line,
  link: ROLE_LINKS[r.company] ?? (r.href ? { href: r.href, label: 'Case study' } : undefined),
}));

/* How I work: what I do and how, merged into one list so neither repeats
   the other. No taglines. Each row links to the studies that show it. */
const WORK: Array<{ name: string; body: string; links: Array<{ href: string; label: string }> }> = [
  {
    name: 'Development',
    body: 'Custom WordPress themes built on ACF rather than page builders, Astro for static sites, SvelteKit and Next.js when a project calls for them, and whatever a project already runs on. I inherit a lot of other people’s code, and I try to leave it easier to maintain than I found it.',
    links: [
      { href: '/work/rally-trailer/', label: 'Rally Trailer' },
      { href: '/work/lincoln-academy/', label: 'Lincoln Academy' },
      { href: '/work/meal-planner/', label: 'Meal Planner' },
    ],
  },
  {
    name: 'Integrations and automation',
    body: 'Form-driven approval workflows, lead routing, Zapier pipelines, and the connections between a site and the tools a business already uses. Low-code where low-code works, and real code where it stops working.',
    links: [
      { href: '/work/rally-trailer/', label: 'Rally Trailer' },
      { href: '/work/lincoln-academy/', label: 'Lincoln Academy' },
    ],
  },
  {
    name: 'Investigating problems',
    body: 'When something breaks, I don’t trust the first explanation. I go to the evidence — network requests, response headers, a byte-for-byte diff, a fresh production build — until the real cause shows up. Three of these are written up in full: a cache serving stale security tokens, shared server state breaking a page, and a template the server kept running from an old compiled copy.',
    links: [
      { href: '/work/rally-trailer/', label: 'Rally Trailer' },
      { href: '/work/all-in/', label: 'ALL IN Tournament' },
      { href: '/work/prolook/', label: 'PROLOOK' },
    ],
  },
  {
    name: 'Working with design and marketing teams',
    body: 'Most of my work is for marketing teams, alongside designers and engineers. I work from Figma, take part in staging and production releases, and build pages a marketing team can update without waiting on a developer.',
    links: [
      { href: '/work/prolook/', label: 'PROLOOK' },
      { href: '/work/all-in/', label: 'ALL IN Tournament' },
    ],
  },
];

/*
  Education and certifications, from the résumé (2026-10-25). The degree is
  completed (confirmed 2026-10-25); no year given, so none is shown.
*/
const DEGREE = {
  name: 'B.S. in University Studies',
  detail: 'Minors in Digital Media and Criminal Justice',
  status: 'Completed',
  school: 'Utah Valley University',
};

const CERTS: Array<{ name: string; issuer: string; detail?: string; year: string }> = [
  { name: 'Web Designer', issuer: 'Utah Valley University', year: '2022' },
  { name: 'Web Developer', issuer: 'Utah Valley University', detail: 'HTML, CSS, JavaScript', year: '2022' },
  { name: 'Social Media Certified', issuer: 'HubSpot Academy', year: '2026' },
  /* The no-break space keeps "Marketing 1" on one line. */
  { name: 'Influencer Marketing 1, Industry Specialist', issuer: 'Meltwater Academy', detail: 'Certificate of Achievement', year: '2026' },
];

/* A client saying the work was good. Day and month only; the year isn't on
   record and isn't guessed. */
const RECOGNITION = [{ name: 'Certificate of Excellence', issuer: 'Lincoln Academy', date: '18 May' }];

/* Outdoor training: part of the personal section, not the professional
   certifications. */
const OUTDOOR = [
  { name: 'Canyoneering 1 and 2', issuer: 'American Canyoneering Association' },
  { name: 'Canyoneering Level 1 and 2', issuer: 'V7 Academy' },
];
---

<Base
  title="About"
  description="Brendon Jensen — full-stack developer in Utah building custom websites, web apps, integrations and automations, with a background in design and marketing."
>
  <section class="ab-open" aria-labelledby="about-title">
    <div class="container-bleed ab-grid ab-intro">
      <div class="ab-intro__text">
        <h1 id="about-title" class="ab-title text-page-long type-display-sentence text-fg" data-split>Hi, I'm Brendon</h1>
        <p class="ab-p mt-stack text-lead text-fg">
          I'm a full-stack developer in Utah. I build custom websites, web apps, integrations and
          automations — custom WordPress themes, dealer portals, registration flows, and the workflows
          that connect a site to the rest of a business.
        </p>
        <p class="ab-p mt-5 text-body text-fg">
          My background in design and marketing helps me think about both how a page feels to use and
          what it's there to do for the business. I enjoy hard problems, and some of my favorite work
          has been making systems that already exist work better.
        </p>
      </div>
      <div class="ab-intro__portrait">
        <Image
          src={portrait}
          alt="Brendon Jensen standing in a field below Mt. Timpanogos in the fall."
          widths={[400, 640, 900, 1128]}
          sizes="(min-width: 64rem) 30vw, (min-width: 48rem) 36vw, 90vw"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="ab-sec" aria-labelledby="exp-title">
    <div class="container-bleed">
      <h2 id="exp-title" class="ab-h text-section text-fg" data-split>Experience</h2>
      <ol class="ab-exp mt-block" role="list">
        {
          EXPERIENCE.map((r) => (
            <li class="ab-exp__row">
              <p class="ab-exp__dates text-small text-fg-muted tabular-nums">
                {r.dates ? r.dates : showPlaceholders && <span class="text-fg">[DATE?]</span>}
              </p>
              <div class="ab-exp__main">
                <h3 class="text-lead font-semibold text-fg">{r.company}</h3>
                <p class="mt-1 text-body text-fg-muted">{r.title}</p>
                <p class="ab-p mt-2 text-body text-fg">{r.line}</p>
                {r.link && (
                  <p class="mt-3 text-body">
                    <a href={r.link.href} class={textLink}>
                      {r.link.label}
                    </a>
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="ab-sec bg-surface-sunken" aria-labelledby="work-title">
    <div class="container-bleed">
      <h2 id="work-title" class="ab-h text-section text-fg" data-split>How I work</h2>
      <ul class="ab-work mt-block" role="list">
        {
          WORK.map((w) => (
            <li class="ab-work__row">
              <h3 class="ab-work__name text-title text-fg">{w.name}</h3>
              <div class="ab-work__text">
                <p class="ab-p text-body text-fg">{w.body}</p>
                <p class="ab-work__links mt-3 text-body">
                  {w.links.map((l) => (
                    <a href={l.href} class={textLink}>
                      {l.label}
                    </a>
                  ))}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="ab-sec" aria-labelledby="tt-title">
    <div class="container-bleed ab-grid ab-tt">
      <div class="ab-tt__photo">
        <Image
          src={trekkers}
          alt="Brendon and Kaylee standing together in a glowing orange slot canyon."
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 64rem) 34vw, (min-width: 48rem) 40vw, 90vw"
        />
      </div>
      <div class="ab-tt__text">
        <h2 id="tt-title" class="ab-h text-section type-display-sentence text-fg" data-split>Building The Twilight Trekkers</h2>
        <p class="ab-p mt-stack text-body text-fg">
          My wife Kaylee and I started The Twilight Trekkers in 2021. It's an outdoor photography and
          travel brand with about 26k followers on Instagram. Kaylee takes most of our photos. I build and
          maintain the website, handle the SEO, write the blog posts, fly the drone and edit the drone
          videos, shoot some of the photos and video, and do most of the trip planning.
        </p>
        <p class="ab-p mt-5 text-body text-fg">
          Running it gives me firsthand experience building and maintaining a website for our own
          audience: every decision about SEO, speed and what's easy to update is one I live with.
        </p>
        <p class="mt-5 text-body">
          <a href="/twilight-trekkers/" class={textLink}>See The Twilight Trekkers <span aria-hidden="true">→</span></a>
        </p>

        <div class="mt-block">
          <h3 class="eyebrow">Canyoneering training</h3>
          <ul class="ab-cred mt-3" role="list">
            {
              OUTDOOR.map((c) => (
                <li>
                  <p class="text-body font-semibold text-fg">{c.name}</p>
                  <p class="text-body text-fg-muted">{c.issuer}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="ab-sec bg-surface-sunken" aria-labelledby="cred-title">
    <div class="container-bleed">
      <h2 id="cred-title" class="ab-h text-section type-display-sentence text-fg" data-split>Education and certifications</h2>
      <p class="mt-stack text-body">
        <ExternalLink href={RESUME} newTab class={textLink}>Résumé (PDF)</ExternalLink>
      </p>

      <div class="ab-creds mt-block">
        <div>
          <h3 class="eyebrow">Education</h3>
          <ul class="ab-cred mt-3" role="list">
            <li>
              <div>
                <p class="text-body font-semibold text-fg">{DEGREE.name}</p>
                <p class="text-body text-fg-muted">{DEGREE.detail}</p>
              </div>
              <p class="text-body text-fg-muted">{DEGREE.school} · {DEGREE.status}</p>
            </li>
          </ul>
        </div>

        <div>
          <h3 class="eyebrow">Professional certifications</h3>
          <ul class="ab-cred mt-3" role="list">
            {
              CERTS.map((c) => (
                <li>
                  <div>
                    <p class="text-body font-semibold text-fg">{c.name}</p>
                    {c.detail && <p class="text-body text-fg-muted">{c.detail}</p>}
                  </div>
                  <p class="text-body text-fg-muted">
                    {c.issuer} · {c.year}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h3 class="eyebrow">Recognition</h3>
          <ul class="ab-cred mt-3" role="list">
            {
              RECOGNITION.map((r) => (
                <li>
                  <p class="text-body font-semibold text-fg">{r.name}</p>
                  <p class="text-body text-fg-muted">
                    {r.issuer} · {r.date}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* Contact: the site footer, on every page, is the contact section
      (email, Copy email, profiles and the Contact link), so the page ends
      straight into it rather than repeating it. */}
</Base>

<style>
  .ab-open {
    padding-top: var(--spacing-block);
    padding-bottom: var(--spacing-section);
  }

  .ab-sec {
    padding-block: var(--spacing-section);
  }

  /* Comfortable reading width for every paragraph. */
  .ab-p {
    max-width: 65ch;
  }

  /* Section headings are the section step; short ones in caps, the long
     ones in sentence case. Allowed to wrap between words. */
  .ab-h {
    text-wrap: balance;
  }

  .ab-grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    row-gap: var(--spacing-block);
  }
  .ab-grid > :global(*) {
    grid-column: 1 / -1;
    min-width: 0;
  }

  /* Intro: the greeting and two paragraphs, the portrait beside them from
     768 and under them on phones. The title is the long page step in
     sentence case, so "Hi, I'm Brendon" sits on one or two lines. */
  .ab-intro__portrait {
    max-width: 24rem;
  }
  .ab-intro__portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--radius-media);
    background: var(--color-surface-raised);
  }
  @media (min-width: 48rem) {
    .ab-intro {
      align-items: center;
    }
    .ab-intro__text {
      grid-column: 1 / span 4;
    }
    .ab-intro__portrait {
      grid-column: 5 / -1;
      max-width: none;
    }
  }
  @media (min-width: 64rem) {
    .ab-intro__text {
      grid-column: 1 / span 7;
    }
    .ab-intro__portrait {
      grid-column: 9 / -1;
    }
  }

  /* Experience: ruled rows, the dates in a narrow column beside the role
     from 768. */
  .ab-exp {
    list-style: none;
    padding: 0;
    border-bottom: 1px solid var(--color-edge);
  }
  .ab-exp__row {
    display: grid;
    gap: 0.4rem var(--grid-gutter);
    padding-block: 1.75rem;
    border-top: 1px solid var(--color-edge);
  }
  @media (min-width: 48rem) {
    .ab-exp__row {
      grid-template-columns: 10rem minmax(0, 1fr);
      align-items: baseline;
    }
  }
  @media (min-width: 64rem) {
    .ab-exp__row {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    }
  }

  /* How I work: one ruled row each, the name left and its text right from
     1024. */
  .ab-work {
    list-style: none;
    padding: 0;
    border-bottom: 1px solid var(--color-edge);
  }
  .ab-work__row {
    display: grid;
    gap: 0.75rem var(--grid-gutter);
    padding-block: 1.75rem;
    border-top: 1px solid var(--color-edge);
  }
  @media (min-width: 64rem) {
    .ab-work__row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: baseline;
    }
  }
  .ab-work__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
  }

  /* The Twilight Trekkers: one photograph beside the text. */
  .ab-tt__photo {
    max-width: 26rem;
  }
  .ab-tt__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 58%;
    border-radius: var(--radius-media);
    background: var(--color-surface-raised);
  }
  @media (min-width: 48rem) {
    .ab-tt {
      align-items: start;
    }
    .ab-tt__photo {
      grid-column: 1 / span 3;
      max-width: none;
    }
    .ab-tt__text {
      grid-column: 4 / -1;
    }
  }
  @media (min-width: 64rem) {
    .ab-tt__photo {
      grid-column: 1 / span 5;
    }
    .ab-tt__text {
      grid-column: 7 / -1;
    }
  }

  /* Credentials: three compact groups, side by side from 1024. */
  .ab-creds {
    display: grid;
    gap: var(--spacing-block) var(--grid-gutter);
  }
  @media (min-width: 64rem) {
    .ab-creds {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ab-cred {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--color-edge-strong);
  }
  .ab-cred li {
    display: grid;
    gap: 0.2rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-edge);
  }
</style>
