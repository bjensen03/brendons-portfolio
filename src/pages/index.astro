---
import Base from '../layouts/Base.astro';
import Opening from '../components/home/Opening.astro';
import Hero from '../components/home/Hero.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import TechnicalSkills from '../components/home/TechnicalSkills.astro';
import Testimonials from '../components/home/Testimonials.astro';
import TwilightSection from '../components/home/TwilightSection.astro';

/*
  Home page.

  Opening (first visit of a session) → full-screen hero over the code field
  → Selected work → Technical skills → What people say → The Twilight
  Trekkers (short). The closing contact section (#contact) is the site
  footer, from Base. Experience lives on the About page.

  Motion lives in src/scripts/home-motion.ts (the Twilight section's in
  src/scripts/twilight-motion.ts), registered from each section;
  motion.css (loaded site-wide from Base) is its CSS half. Everything is
  fully visible without JS or with reduced motion.
*/
---

<Base preloadMono>
  <Opening />
  <Hero />
  <SelectedWork />
  <TechnicalSkills />
  <Testimonials />
  <TwilightSection />
</Base>
