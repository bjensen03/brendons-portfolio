---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import StrataBand from '../components/StrataBand.astro';

/*
  Placeholder home page. The real strata hero, selected work, lenses strip and
  proof strip are Phase 2 — this page exists so the foundation can be seen
  working end to end: tokens, type scale, both accents, the reveal helpers, the
  split headline and the parallax band all appear below.
*/
---

<Base>
  <Section size="compact" surface="sunken" width="measure">
    <p class="text-2xs tracking-widest text-accent uppercase">Phase 1 — foundation</p>
    <h1 class="mt-6 font-display text-4xl tracking-tightest md:text-5xl" data-split>
      Groundwork, not the hero.
    </h1>
    <p class="mt-6 text-lg text-fg-muted">
      The design tokens, motion system, content schemas and page shell are in place. The
      layered hero, case studies and lab replace this page in later phases.
    </p>
  </Section>

  <StrataBand facing="down" size="lg" />

  <Section revealGroup width="content">
    <h2 class="text-2xl tracking-tighter md:text-3xl" data-reveal>What's wired up</h2>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2">
      <li class="rounded-card border border-edge bg-surface-raised p-6" data-reveal>
        <h3 class="text-lg text-accent">Motion module</h3>
        <p class="mt-2 text-sm text-fg-muted">
          Lenis driven from the GSAP ticker, ScrollTrigger wired to it, and every animation
          torn down before a view transition swaps the DOM.
        </p>
      </li>
      <li class="rounded-card border border-edge bg-surface-raised p-6" data-reveal>
        <h3 class="text-lg text-accent">Reduced motion</h3>
        <p class="mt-2 text-sm text-fg-muted">
          One switch, checked in one place, reactive to being toggled mid-session. Content
          stays visible whether or not the animations ever run.
        </p>
      </li>
      <li class="rounded-card border border-edge bg-surface-raised p-6" data-reveal>
        <h3 class="text-lg text-accent-secondary">Design tokens</h3>
        <p class="mt-2 text-sm text-fg-muted">
          Colour, type, spacing, easing and duration all defined once. Contrast on this
          surface was measured, not guessed.
        </p>
      </li>
      <li class="rounded-card border border-edge bg-surface-raised p-6" data-reveal>
        <h3 class="text-lg text-accent-secondary">Content schemas</h3>
        <p class="mt-2 text-sm text-fg-muted">
          Case studies fail the build without a named technical problem, and client work
          fails without confirmed permission to publish.
        </p>
      </li>
    </ul>
  </Section>

  <StrataBand facing="up" size="md" seam={false} />
</Base>
