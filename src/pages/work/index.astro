---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { DISCIPLINES } from '../../content.config';

/*
  Work index.

  Deep studies get a large row with a cover image; short cards get a compact
  text row; concepts are grouped separately and labelled, so spec work is never
  presented as client work.

  Filtering is plain DOM — a handful of buttons toggling a data attribute. It
  needs no framework, it degrades to showing everything without JS, and the
  count is announced so a screen reader learns the list changed.
*/

const projects = await getCollection('projects');
const sorted = projects.sort((a, b) => a.data.order - b.data.order);

const studies = sorted.filter((p) => p.data.depth === 'study');
const cards = sorted.filter((p) => p.data.depth === 'card');
const concepts = sorted.filter((p) => p.data.depth === 'concept');

const hasWork = sorted.length > 0;
---

<Base title="Work" description="Case studies and client work by Brendon Jensen.">
  <Section width="wide" size="compact">
    <h1
      class="font-display text-6xl uppercase md:text-8xl"
      style="letter-spacing: var(--tracking-display);"
      data-split
    >
      Work
    </h1>

    {
      hasWork ? (
        <div class="mt-10 flex flex-wrap items-center gap-2" data-filters>
          <span class="mr-2 font-body text-2xs tracking-widest text-fg-faint uppercase">
            Filter
          </span>
          <button
            type="button"
            data-filter="all"
            aria-pressed="true"
            class="transition-soft rounded-full border border-edge px-4 py-1.5 font-body text-2xs tracking-widest uppercase hover:border-signal aria-[pressed=true]:border-signal aria-[pressed=true]:text-signal"
          >
            Everything
          </button>
          {DISCIPLINES.map((discipline) => (
            <button
              type="button"
              data-filter={discipline}
              aria-pressed="false"
              class="transition-soft rounded-full border border-edge px-4 py-1.5 font-body text-2xs tracking-widest uppercase hover:border-signal aria-[pressed=true]:border-signal aria-[pressed=true]:text-signal"
            >
              {discipline}
            </button>
          ))}
          <p class="sr-only" role="status" data-filter-status />
        </div>
      ) : (
        <p class="mt-10 max-w-measure font-body text-lg text-fg-muted">
          No published case studies yet. They land here as they're written — the schema in
          <code class="font-mono text-fg">src/content.config.ts</code> is the authority on what
          each one needs.
        </p>
      )
    }
  </Section>

  {
    studies.length > 0 && (
      <Section width="wide" size="compact" revealGroup>
        <ul class="grid gap-16">
          {studies.map((study) => (
            <li data-item data-disciplines={study.data.disciplines.join(' ')} data-reveal>
              <a href={`/work/${study.id}/`} class="group grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-center">
                <div class="overflow-hidden rounded-card border border-edge">
                  <Image
                    src={study.data.cover}
                    alt={study.data.coverAlt}
                    widths={[480, 720, 1080]}
                    sizes="(min-width: 1024px) 40rem, 100vw"
                    class="w-full transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                  />
                </div>

                <div>
                  <p class="font-body text-2xs tracking-widest text-fg-faint uppercase">
                    {study.data.client} · {study.data.year}
                  </p>
                  <h2
                    class="mt-4 font-display text-4xl uppercase transition-soft group-hover:text-signal md:text-6xl"
                    style="letter-spacing: var(--tracking-display);"
                    transition:name={`study-${study.id}`}
                  >
                    {study.data.title}
                  </h2>
                  <p class="mt-5 max-w-measure font-body text-lg text-fg-muted">
                    {study.data.outcome}
                  </p>
                  <p class="mt-6 font-body text-2xs tracking-widest text-signal uppercase">
                    Read the case study →
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    cards.length > 0 && (
      <Section width="wide" surface="sunken" revealGroup>
        <h2 class="font-body text-2xs tracking-widest text-fg-faint uppercase" data-reveal>
          Also built
        </h2>
        <ul class="mt-8 border-t border-edge">
          {cards.map((card) => (
            <li
              class="border-b border-edge"
              data-item
              data-disciplines={card.data.disciplines.join(' ')}
              data-reveal
            >
              <div class="grid gap-2 py-6 md:grid-cols-[1fr_2fr_auto] md:items-baseline md:gap-10">
                <span class="font-body text-lg text-fg-bright">{card.data.client}</span>
                <span class="font-body text-base text-fg-muted">{card.data.outcome}</span>
                <span class="font-body text-2xs tracking-widest text-fg-faint uppercase">
                  {card.data.year}
                </span>
              </div>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    concepts.length > 0 && (
      <Section width="wide" revealGroup>
        <h2 class="font-body text-2xs tracking-widest text-fg-faint uppercase" data-reveal>
          Concepts — self-directed, not client work
        </h2>
        <ul class="mt-8 grid gap-8 md:grid-cols-2">
          {concepts.map((concept) => (
            <li data-item data-disciplines={concept.data.disciplines.join(' ')} data-reveal>
              <a href={`/work/${concept.id}/`} class="group block">
                <Image
                  src={concept.data.cover}
                  alt={concept.data.coverAlt}
                  widths={[480, 720]}
                  sizes="(min-width: 768px) 30rem, 100vw"
                  class="w-full rounded-card border border-edge"
                />
                <h3 class="mt-5 font-display text-2xl uppercase transition-soft group-hover:text-signal">
                  {concept.data.title}
                </h3>
                <p class="mt-2 font-body text-sm text-fg-muted">{concept.data.outcome}</p>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )
  }
</Base>

<script>
  /*
    Discipline filtering.

    Independent of the motion module, because filtering has to work whether or
    not GSAP loaded. Document-level listeners are bound once; the per-page setup
    is idempotent, so re-running it on view transitions can't stack handlers.
  */
  const applyFilter = (value: string) => {
    const items = document.querySelectorAll<HTMLElement>('[data-item]');
    let shown = 0;

    items.forEach((item) => {
      const match = value === 'all' || (item.dataset.disciplines ?? '').split(' ').includes(value);
      item.hidden = !match;
      if (match) shown += 1;
    });

    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.filter === value));
    });

    /* Announce the change — visually the list just shrinks, which tells a
       screen reader user nothing at all. */
    const status = document.querySelector<HTMLElement>('[data-filter-status]');
    if (status) {
      status.textContent =
        value === 'all'
          ? `Showing all ${shown} projects`
          : `Showing ${shown} ${value} project${shown === 1 ? '' : 's'}`;
    }
  };

  const setupFilters = () => {
    const bar = document.querySelector<HTMLElement>('[data-filters]');
    if (!bar || bar.dataset.ready === 'true') return;
    bar.dataset.ready = 'true';

    bar.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-filter]');
      if (button?.dataset.filter) applyFilter(button.dataset.filter);
    });
  };

  setupFilters();
  document.addEventListener('astro:page-load', setupFilters);
</script>
