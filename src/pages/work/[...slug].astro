---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Container from '../../components/Container.astro';
import UnderTheHood from '../../components/study/UnderTheHood.astro';
import Stat from '../../components/study/Stat.astro';
import Stats from '../../components/study/Stats.astro';
import Figure from '../../components/study/Figure.astro';
import BeforeAfter from '../../components/study/BeforeAfter.astro';

/*
  Case study page.

  Body sections are written in the MDX itself; this file supplies the hero, the
  under-the-hood block and the next/previous navigation. The study components
  are passed into the MDX so they can be used without an import in every file.
*/

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  /* Concepts get a page too — they're clearly labelled as self-directed rather
     than passed off as client work. */
  const studies = projects
    .filter((project) => project.data.depth !== 'card')
    .sort((a, b) => a.data.order - b.data.order);

  return studies.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      previous: index > 0 ? studies[index - 1] : undefined,
      next: index < studies.length - 1 ? studies[index + 1] : undefined,
    },
  }));
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

/* Passed into the MDX so a case study can use them without importing anything.
   UnderTheHood is authored in the body rather than rendered here, because its
   code snippet has to be a fenced block inside it. */
const components = { Stat, Stats, Figure, BeforeAfter, UnderTheHood };
---

<Base title={data.title} description={data.outcome} ogImage={data.cover.src}>
  <article>
    <header class="border-b border-edge bg-surface-sunken pt-16 pb-14">
      <Container width="wide">
        <div class="flex flex-wrap items-center gap-3">
          {
            data.depth === 'concept' && (
              <p class="rounded-full border border-signal px-3 py-1 font-body text-2xs tracking-widest text-signal uppercase">
                Self-directed concept
              </p>
            )
          }
          <p class="font-body text-2xs tracking-widest text-fg-faint uppercase">
            {data.client} · {data.year}
          </p>
        </div>

        {/* Shares a transition name with its row on the work index, so the
            title morphs into place rather than the page cutting. */}
        <h1
          class="mt-8 max-w-[16ch] font-display text-5xl leading-[0.9] uppercase md:text-7xl"
          style="letter-spacing: var(--tracking-display);"
          transition:name={`study-${entry.id}`}
        >
          {data.title}
        </h1>

        <p class="mt-8 max-w-measure font-body text-xl text-fg md:text-2xl">{data.outcome}</p>

        <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2">
          {
            data.role.map((role) => (
              <li class="font-body text-2xs tracking-widest text-fg-faint uppercase">{role}</li>
            ))
          }
        </ul>
      </Container>
    </header>

    <Container width="wide">
      <Image
        src={data.cover}
        alt={data.coverAlt}
        widths={[640, 960, 1440, 1920]}
        sizes="(min-width: 1440px) 88rem, 100vw"
        class="mt-14 w-full rounded-card border border-edge"
      />
    </Container>

    {/* The reading column is narrower than the page so long-form prose keeps a
        sane measure; figures break out of it deliberately. */}
    <Container width="content">
      <div
        class="prose-study mx-auto mt-20 max-w-measure font-body text-lg text-fg"
      >
        <Content components={components} />
      </div>
    </Container>

    {
      (previous || next) && (
        <nav class="mt-24 border-t border-edge" aria-label="More work">
          <Container width="wide">
            <ul class="grid gap-px md:grid-cols-2">
              {previous && (
                <li>
                  <a
                    href={`/work/${previous.id}/`}
                    class="transition-soft group block py-10 pr-6"
                  >
                    <span class="font-body text-2xs tracking-widest text-fg-faint uppercase">
                      Previous
                    </span>
                    <span class="mt-3 block font-display text-3xl uppercase transition-soft group-hover:text-signal">
                      {previous.data.title}
                    </span>
                  </a>
                </li>
              )}
              {next && (
                <li class="md:text-right">
                  <a href={`/work/${next.id}/`} class="transition-soft group block py-10 pl-6">
                    <span class="font-body text-2xs tracking-widest text-fg-faint uppercase">
                      Next
                    </span>
                    <span class="mt-3 block font-display text-3xl uppercase transition-soft group-hover:text-signal">
                      {next.data.title}
                    </span>
                  </a>
                </li>
              )}
            </ul>
          </Container>
        </nav>
      )
    }
  </article>
</Base>
