---
import { Picture } from 'astro:assets';
import { textLink } from './data';
import { SHOTS, FOLLOWERS, TWILIGHT_PAGE } from './twilight-data';

/*
  The Twilight Trekkers, near the end of the homepage: kept short on
  purpose. One photo with the name over it, a sentence, the follower count
  and a link to /twilight-trekkers/, where the photos, reels and brands
  live. The photo settles from a slight zoom as it arrives and drifts while
  it's on screen; the name rises in and the count ticks up.
*/

const COVER = SHOTS.archSunrise;
---

<section class="td bg-white py-section" aria-labelledby="td-title">
  <div class="container-bleed">
    <div class="grid grid-cols-4 gap-x-(--grid-gutter) md:grid-cols-6 lg:grid-cols-12">
      <div class="td-cover col-span-full lg:col-span-8">
        <div class="td-cover__mask" data-mask>
          <div class="td-cover__inner">
            <div class="td-cover__drift" data-parallax="-60">
              <div class="td-cover__zoom" data-td-zoom>
                <Picture
                  src={COVER.src}
                  alt={COVER.alt}
                  formats={['avif', 'webp']}
                  widths={[640, 960, 1280, 1600, 2000, 2400].filter((w) => w <= COVER.src.width)}
                  sizes="(min-width: 64rem) 66vw, 100vw"
                  loading="lazy"
                  pictureAttributes={{ class: 'block h-full w-full' }}
                  class="h-full w-full object-cover"
                  style={`object-position:${COVER.focus}`}
                />
              </div>
            </div>
          </div>
        </div>
        <div class="td-cover__scrim" aria-hidden="true"></div>
        <h2 id="td-title" class="td-name" data-tone="dark" data-split>
          <span class="block"><span class="td-the">The</span>{' '}<span>Twilight</span></span>{' '}
          <span class="block">Trekkers</span>
        </h2>
      </div>

      <div
        class="col-span-full mt-block flex flex-col gap-block md:col-span-4 lg:col-span-4 lg:col-start-9 lg:mt-0 lg:justify-between"
        data-reveal-group
      >
        <p class="max-w-measure text-lead text-fg" data-reveal>
          Kaylee and I started The Twilight Trekkers in 2021: travel and adventure photos, reels and
          stories from the places we go.
        </p>
        <div data-reveal>
          <p class="td-count text-fg tabular-nums" data-count>{FOLLOWERS}</p>
          <p class="mt-3 max-w-measure text-lead text-fg">people follow along on Instagram.</p>
        </div>
        <p class="text-body" data-reveal>
          <a href={TWILIGHT_PAGE} class:list={[textLink, 'group']}>
            See the Twilight Trekkers<span class="link-arrow ml-1" aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .td {
    overflow: clip;
  }

  /* ── 1. Cover (as B) ─────────────────────────────────────────────── */
  .td-cover {
    position: relative;
    isolation: isolate;
    margin-inline: calc(-1 * var(--grid-margin));
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: var(--color-charcoal);
  }
  @media (min-width: 48rem) {
    .td-cover {
      aspect-ratio: 4 / 3;
    }
  }
  @media (min-width: 64rem) {
    .td-cover {
      margin-right: 0;
      aspect-ratio: auto;
      min-height: 40vw;
      border-radius: 0 var(--radius-media) var(--radius-media) 0;
    }
  }
  .td-cover__mask {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }
  /* Three layers, one transform each: the mask's wipe nudges __inner, the
     parallax moves __drift, the arrival zoom scales __zoom. */
  .td-cover__inner {
    position: absolute;
    inset: 0;
  }
  .td-cover__drift {
    position: absolute;
    inset: -2% 0 -14% 0;
  }
  .td-cover__zoom {
    height: 100%;
    transform-origin: 62% 70%;
  }
  .td-cover__zoom :global(picture) {
    height: 100%;
  }
  /* The cover photo (person under the arch, 2026-10-25) has its subject in
     the lower third and open sky on top, so the name sits at the top over
     the sky and the scrim runs down from there. A short fade at the bottom
     still settles the photo into the band below. */
  .td-cover__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to bottom,
        var(--color-charcoal) 0%,
        color-mix(in oklch, var(--color-charcoal) 80%, transparent) 22%,
        color-mix(in oklch, var(--color-charcoal) 30%, transparent) 40%,
        transparent 55%
      ),
      linear-gradient(to top, color-mix(in oklch, var(--color-charcoal) 60%, transparent) 0%, transparent 18%);
  }
  .td-name {
    position: absolute;
    left: var(--grid-margin);
    right: var(--grid-margin);
    top: var(--grid-margin);
    background: transparent;
    color: var(--color-fg);
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: 900;
    line-height: 0.86;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    /* A display exception (the cover), but never bigger than a page title
       at the same width (the heading scale). */
    font-size: min(var(--text-page), calc((100vw - 2 * var(--grid-margin)) / 6.7));
  }
  .td-the {
    display: block;
  }
  @media (min-width: 64rem) {
    .td-name {
      font-size: min(var(--text-page), calc(((100vw - 2 * var(--grid-margin)) * 8 / 12 - var(--grid-margin)) / 8.7), 9rem);
    }
    .td-the {
      display: inline;
    }
  }
  .td-count {
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    font-size: min(calc((100vw - 2 * var(--grid-margin)) / 3.4), 11rem);
  }
  @media (min-width: 48rem) {
    .td-count {
      font-size: min(calc((100vw - 2 * var(--grid-margin)) / 4.4), 11rem);
    }
  }
  @media (min-width: 64rem) {
    .td-count {
      font-size: min(calc((100vw - 2 * var(--grid-margin)) * 4 / 12 / 2.5), 11rem);
    }
  }
</style>

<script>
  import { registerMotion } from '../../scripts/motion';
  import { twilightCoverZoom } from '../../scripts/twilight-motion';

  registerMotion(twilightCoverZoom);
</script>
