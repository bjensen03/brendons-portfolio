---
import { experience, textLink } from './data';
import { showPlaceholders } from '../../lib/placeholders';

/*
  Experience. Roles, companies and dates are printed exactly as the studies
  state them. Anything not on record renders DATE? / [PLACEHOLDER] in dev so
  it reads as missing, not as a plausible fact; a build leaves it out.
*/

const roles = await experience();
---

<section class="bg-ground py-section-sm" aria-labelledby="experience-title">
  <div class="container-bleed">
    <div class="grid grid-cols-4 gap-x-(--grid-gutter) md:grid-cols-6 lg:grid-cols-12">
      <div class="col-span-full self-start lg:sticky lg:top-[calc(var(--spacing-nav)+2rem)] lg:col-span-4">
        <h2 id="experience-title" class="text-section text-fg" data-split>Experience</h2>
      </div>

      <ol class="relative col-span-full mt-10 md:mt-block lg:col-span-7 lg:col-start-6 lg:mt-0" data-exp>
        {/* The rule is a real element, not ::before, so it can be drawn down
            with the scroll (home-motion.ts). Full height without motion. */}
        <span
          class="absolute inset-y-0 left-0 w-px origin-top bg-edge md:left-36"
          aria-hidden="true"
          data-exp-rule
        ></span>
        {
          roles.map((role) => (
            <li
              class="py-8 pl-8 md:grid md:grid-cols-[9rem_1fr] md:items-baseline md:pl-0"
              data-reveal="manual"
              data-exp-row
            >
              <p class="text-small text-fg-muted tabular-nums">
                {role.dates ? (
                  role.dates
                ) : (
                  showPlaceholders && <span class="text-fg">[DATE?]</span>
                )}
              </p>
              <div class="md:pl-8">
                <h3 class="relative mt-1 text-lead font-semibold text-fg md:mt-0">
                  <span
                    class="absolute top-[0.7em] -left-8 size-[7px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-fg"
                    aria-hidden="true"
                  />
                  {role.company}
                </h3>
                <p class="mt-1 text-body text-fg-muted">{role.title}</p>
                <p class="mt-2 max-w-measure text-body text-fg-muted">{role.line}</p>
                {role.href && (
                  <p class="mt-3">
                    <a href={role.href} class={textLink}>
                      Case study<span class="sr-only">: {role.company}</span>
                    </a>
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import { registerMotion } from '../../scripts/motion';
  import { experienceTimeline } from '../../scripts/home-motion';

  registerMotion(experienceTimeline);
</script>
