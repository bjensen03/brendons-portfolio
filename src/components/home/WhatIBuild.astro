---
import { buildLines, highlight } from './snippets';

/*
  What I build. One huge line per discipline, and beside it a code panel
  showing where I actually did that — a short excerpt from a case
  study and the project's name.

  Without JS or with reduced motion this is a plain list of the disciplines
  followed by every snippet in order, all at full strength. With motion,
  home-motion.ts dims the lines that aren't crossing the middle of the
  screen, stacks the snippets in one cell (so the panel is always as tall as
  the tallest and switching can't move anything) and types out the one that
  matches the active line.
*/
---

<section id="what-i-build" class="py-section" aria-labelledby="build-title" data-build>
  <div class="container-bleed">
    <h2 id="build-title" class="sr-only">What I build</h2>

    <div class="grid grid-cols-4 gap-x-(--grid-gutter) md:grid-cols-6 lg:grid-cols-12">
      <ol class="build-lines col-span-full lg:col-span-8" data-build-lines>
        {
          buildLines.map((line, i) => (
            <li class="build-line text-heading text-fg md:text-display" data-build-line={i}>
              {line.label}
            </li>
          ))
        }
      </ol>

      <div
        class="build-panel col-span-full mt-block min-w-0 lg:col-span-4 lg:col-start-9 lg:mt-0 lg:self-start"
        data-build-panel
      >
        {
          buildLines.map((line, i) => (
            <figure class="build-snippet" data-build-snippet={i}>
              <figcaption class="text-small text-fg">
                <span class="sr-only">{line.label}: </span>
                {line.project}
                <span class="text-fg-muted"> · {line.snippet.lang}</span>
              </figcaption>
              <pre class="build-code" data-build-code data-lenis-prevent-horizontal><code>{highlight(line.snippet.code).map((t) => (
                t.role === 'plain' ? t.text : <span class={`tok-${t.role}`}>{t.text}</span>
              ))}</code></pre>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .build-line {
    padding-block: 0.08em;
    overflow-wrap: normal;
    /* Scrubbed by home-motion.ts: 0 = dim, 1 = lit. 1 by default, so the
       list is full strength without motion. These are real content, so the
       dim floor is 54% — large text at 3:1 or better across the whole --lum
       range — and the lit line also gains a touch of scale. */
    --lit: 1;
    color: color-mix(in oklch, var(--color-fg) calc(54% + 46% * var(--lit)), transparent);
    transform-origin: 0% 50%;
    scale: calc(0.97 + 0.03 * var(--lit));
  }

  .build-snippet + .build-snippet {
    margin-top: var(--spacing-block);
  }

  .build-code {
    margin-top: 0.75rem;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    border: 1px solid var(--color-edge);
    border-radius: var(--radius-media);
    background: var(--color-surface-raised);
    font-family: var(--font-mono);
    font-size: clamp(0.8125rem, 0.25rem + 0.55vw, 1rem);
    line-height: 1.7;
    color: var(--color-fg);
    /* The panel stretches with its four columns; the code inside it stops
       at --measure-code (80 characters) so lines stay readable on a wide
       screen. Wrapped rather than scrolled: typed text that runs off the
       right edge can't be seen arriving. */
    max-inline-size: var(--measure-code);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    tab-size: 2;
  }

  /* Phones narrower than about 360px: the heading step's 36px floor made
     "INTEGRATIONS" (about 9em) wider than the column at 320, and the whole
     page scrolled sideways by 13px. Shrink just enough to fit; 360 and up
     keep the step. */
  @media (max-width: 47.999rem) {
    .build-line {
      font-size: min(var(--text-heading), calc((100vw - 2 * var(--grid-margin)) / 9.1));
    }
  }

  /* "INTEGRATIONS" is the widest unbreakable run (about 9.4em); it's sized
     to fill eight of the full-width columns, so the lines grow with the
     screen instead of stopping at the display step. Ceiling 11rem. 91px at
     1440, 122 at 1920, 163 at 2560. */
  @media (min-width: 64rem) {
    .build-line {
      font-size: min(calc((100vw - 2 * var(--grid-margin)) * 0.068), 11rem);
    }
  }

  /* Two text colours only: fg and fg-muted. The accent is never a glyph
     colour; it appears as the typing caret. */
  .tok-comment {
    color: var(--color-fg-muted);
    font-style: italic;
  }
  .tok-string {
    color: var(--color-fg);
    font-weight: 600;
  }

  .build-code.is-typing code::after {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 1.15em;
    margin-left: 1px;
    vertical-align: text-bottom;
    background: var(--color-accent-fill);
  }

  /* Motion on: one panel, snippets stacked in a single cell. Sticky beside
     the lines on desktop; pinned to the bottom of the screen below that. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.motion-ok) .build-panel {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      position: sticky;
      bottom: 1rem;
      z-index: 1;
      align-self: end;
    }
    :global(html.motion-ok) .build-snippet {
      grid-area: 1 / 1;
      margin: 0;
      visibility: hidden;
    }
    :global(html.motion-ok) .build-snippet.is-active,
    :global(html.motion-ok) .build-panel:not(.is-ready) .build-snippet:first-child {
      visibility: visible;
    }
    :global(html.motion-ok) .build-line {
      --lit: 0;
    }
    /* Leave room to scroll the last line past the middle of the screen. */
    :global(html.motion-ok) .build-lines {
      padding-block: 30vh;
    }

    @media (max-width: 63.999rem) {
      :global(html.motion-ok) .build-panel {
        margin-top: 0;
      }
      :global(html.motion-ok) .build-lines {
        padding-top: 10vh;
      }
      :global(html.motion-ok) .build-code {
        max-height: 14.5em;
        overflow: hidden;
        font-size: 0.75rem;
      }
    }

    /* Phones and tablets: the panel is a dock. It sits flush on the bottom edge on a
       solid ground (past the home indicator), with a short fade above it,
       so the lines scroll away underneath it instead of showing through the
       caption. The line that lights is the one crossing the middle of the
       space above the dock (whatIBuild, home-motion.ts). */
    @media (max-width: 63.999rem) {
      :global(html.motion-ok) .build-panel {
        bottom: 0;
        margin-inline: calc(-1 * var(--grid-margin));
        padding: 0.75rem var(--grid-margin) max(1rem, env(safe-area-inset-bottom));
        background: var(--color-surface);
      }
      /* Out of sight below the edge until the first line nears the
         reading line (is-docked, whatIBuild in home-motion.ts). */
      :global(html.motion-ok) .build-panel.is-ready:not(.is-docked) {
        translate: 0 calc(100% + 3rem);
        visibility: hidden;
        transition:
          translate var(--duration-base) var(--ease-out-soft),
          visibility 0s linear var(--duration-base);
      }
      :global(html.motion-ok) .build-panel.is-docked {
        transition: translate var(--duration-base) var(--ease-out-soft);
      }
      :global(html.motion-ok) .build-panel::before {
        content: '';
        position: absolute;
        inset: auto 0 100% 0;
        height: 3rem;
        background: linear-gradient(to bottom, transparent, var(--color-surface));
        pointer-events: none;
      }
      /* Just enough under the last line for the dock's fade to sit in
         (16svh left a sixth of the screen empty above the dock). */
      :global(html.motion-ok) .build-lines {
        padding-top: 0;
        padding-bottom: 3.5rem;
      }
      /* The dock already ends the section; a full section gap under it
         left a screenful of nothing before Selected Work. */
      :global(html.motion-ok) [data-build] {
        padding-bottom: var(--spacing-stack);
      }
      :global(html.motion-ok) .build-code {
        max-height: 8.6em;
        margin-top: 0.5rem;
        padding: 0.9rem 1rem;
        /* The last lines fade rather than being sliced through. */
        mask-image: linear-gradient(to bottom, black 70%, transparent);
      }
    }

    @media (min-width: 64rem) {
      :global(html.motion-ok) .build-panel {
        top: calc(50vh - 9rem);
        bottom: auto;
        align-self: start;
        margin-top: 30vh;
      }
    }
  }
</style>

<script>
  import { registerMotion } from '../../scripts/motion';
  import { whatIBuild } from '../../scripts/home-motion';

  registerMotion(whatIBuild);
</script>
