---
import Container from './Container.astro';
import { CONTACT, NAV, SITE } from '../config';

/*
  Footer shell. Social links render only when config.ts actually has a URL —
  Phase 0 hasn't collected them all yet, and an anchor pointing at "" is a link
  to the current page dressed up as a profile.
*/

const year = new Date().getFullYear();

const socials = [
  { href: CONTACT.github, label: 'GitHub' },
  { href: CONTACT.linkedin, label: 'LinkedIn' },
  { href: CONTACT.instagram, label: 'Instagram' },
].filter((link) => link.href.length > 0);
---

<footer class="border-t border-edge bg-surface-sunken py-section-sm">
  <Container width="wide">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-measure">
        <p class="font-display text-2xl tracking-tighter text-fg-bright">{SITE.name}</p>
        <p class="mt-3 text-sm text-fg-muted">{SITE.description}</p>
        <a
          href={`mailto:${CONTACT.email}`}
          class="transition-soft mt-5 inline-block text-sm text-accent hover:text-accent-bright"
        >
          {CONTACT.email}
        </a>
      </div>

      <div class="flex gap-12">
        <nav aria-label="Footer">
          <ul class="space-y-2">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="transition-soft text-sm text-fg-muted hover:text-fg-bright"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        {
          socials.length > 0 && (
            <ul class="space-y-2">
              {socials.map((link) => (
                <li>
                  <a
                    href={link.href}
                    rel="me noopener"
                    class="transition-soft text-sm text-fg-muted hover:text-fg-bright"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <p class="mt-12 text-2xs tracking-widest text-fg-faint uppercase">
      &copy; {year} {SITE.name}
    </p>
  </Container>
</footer>
