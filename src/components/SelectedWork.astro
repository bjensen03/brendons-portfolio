---
import { getCollection } from 'astro:content';
import Section from './Section.astro';

/*
  Selected work.

  Reads the projects collection, so this section fills itself in as case studies
  land — no editing here when a study is added. Until then it renders a clearly
  marked placeholder set rather than inventing clients.

  Hover video previews are desktop-only and wired below. A card with no
  `previewVideo` simply doesn't get one, so partial content degrades cleanly.
*/

const projects = await getCollection('projects');

const featured = projects
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 5)
  .map((project) => ({
    slug: project.id,
    client: project.data.client,
    outcome: project.data.outcome,
    year: String(project.data.year),
    disciplines: project.data.disciplines,
    previewVideo: project.data.previewVideo,
    placeholder: false,
  }));

/* Structure is real; the content is not. Marked so it can't be mistaken for
   shipped work — see the Phase 0 list for what has to exist first. */
const placeholders = [
  {
    slug: '',
    client: 'ProLook Sports',
    outcome: 'Rebuilt the marketing front end',
    year: '2026',
    disciplines: ['development', 'design'] as const,
    previewVideo: undefined,
    placeholder: true,
  },
  {
    slug: '',
    client: 'Lincoln Academy',
    outcome: 'Full site revamp for a K–9 charter school',
    year: '2026',
    disciplines: ['development', 'marketing'] as const,
    previewVideo: undefined,
    placeholder: true,
  },
  {
    slug: '',
    client: 'Third case study',
    outcome: 'Still to be chosen',
    year: '2025',
    disciplines: ['development'] as const,
    previewVideo: undefined,
    placeholder: true,
  },
];

const items = featured.length > 0 ? featured : placeholders;
const usingPlaceholders = featured.length === 0;
---

<Section surface="base" width="wide" revealGroup>
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <h2
      class="font-display text-4xl uppercase md:text-6xl"
      style="letter-spacing: var(--tracking-display);"
      data-split
    >
      Selected work
    </h2>
    {
      usingPlaceholders && (
        <p class="font-body text-2xs tracking-widest text-signal uppercase" data-reveal>
          Placeholder — no published case studies yet
        </p>
      )
    }
  </div>

  <ul class="mt-12 border-t border-edge">
    {
      items.map((item) => (
        <li class="border-b border-edge" data-reveal>
          <a
            href={item.placeholder ? '/work/' : `/work/${item.slug}/`}
            class="work-row transition-soft group relative grid items-baseline gap-2 py-7 md:grid-cols-[1.1fr_1.6fr_auto] md:gap-10 md:py-9"
            data-work-row
            data-preview={item.previewVideo}
          >
            <span class="font-body text-xl text-fg-bright transition-soft group-hover:text-signal md:text-2xl">
              {item.client}
            </span>

            <span class="font-body text-base text-fg-muted">{item.outcome}</span>

            <span class="flex items-center gap-4 font-body text-2xs tracking-widest text-fg-faint uppercase">
              <span>{item.disciplines[0]}</span>
              <span aria-hidden="true">·</span>
              <span>{item.year}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>

{
  /*
    One shared preview element rather than one per card. It follows the cursor
    and swaps its source on hover, which keeps a single video decoding at a time
    instead of five. Rendered outside the list so it can't inherit row layout.
  */
}
<div
  class="pointer-events-none fixed top-0 left-0 z-40 hidden w-[22rem] overflow-hidden rounded-card border border-edge opacity-0 shadow-2xl md:block"
  data-work-preview
  aria-hidden="true"
>
  <video muted loop playsinline preload="none" class="block h-full w-full object-cover"></video>
</div>

<script>
  import gsap from 'gsap';
  import { registerMotion, prefersReducedMotion, ease, duration } from '../scripts/motion';

  /*
    Hover previews, desktop only.

    Deliberately gated on a fine pointer rather than a width breakpoint: a touch
    device has no hover, so autoplaying video there would burn a mobile data
    budget for an interaction that can never happen.
  */
  registerMotion(() => {
    const rows = document.querySelectorAll<HTMLAnchorElement>('[data-work-row][data-preview]');
    const preview = document.querySelector<HTMLElement>('[data-work-preview]');
    const video = preview?.querySelector('video');

    if (!rows.length || !preview || !video) return;
    if (prefersReducedMotion()) return;
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    const quickX = gsap.quickTo(preview, 'x', { duration: 0.5, ease: ease.outSoft });
    const quickY = gsap.quickTo(preview, 'y', { duration: 0.5, ease: ease.outSoft });

    const move = (event: PointerEvent) => {
      quickX(event.clientX + 28);
      quickY(event.clientY - preview.offsetHeight / 2);
    };

    const cleanups: Array<() => void> = [];

    rows.forEach((row) => {
      const src = row.dataset.preview;
      if (!src) return;

      const enter = () => {
        if (video.getAttribute('src') !== src) {
          video.setAttribute('src', src);
          /* Play can reject if the user navigates before it resolves. That's
             expected, not an error worth surfacing. */
          void video.play().catch(() => {});
        }
        gsap.to(preview, { opacity: 1, scale: 1, duration: duration.fast, ease: ease.outSoft });
      };

      const leave = () => {
        gsap.to(preview, { opacity: 0, scale: 0.96, duration: duration.fast, ease: ease.outSoft });
      };

      row.addEventListener('pointerenter', enter);
      row.addEventListener('pointerleave', leave);
      row.addEventListener('pointermove', move);

      cleanups.push(() => {
        row.removeEventListener('pointerenter', enter);
        row.removeEventListener('pointerleave', leave);
        row.removeEventListener('pointermove', move);
      });
    });

    return () => {
      cleanups.forEach((cleanup) => cleanup());
      gsap.killTweensOf(preview);
      video.pause();
      video.removeAttribute('src');
      gsap.set(preview, { clearProps: 'transform,opacity' });
    };
  });
</script>
