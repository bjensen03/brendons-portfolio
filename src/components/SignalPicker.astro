---
/*
  Prototype-only signal-colour switcher.

  The palette is settled apart from one decision: the third colour, used for
  hover, focus, buttons and selection. This exists so that colour can be chosen
  by looking at it rather than by reading hex codes.

  Delete this component, its route usage and the [data-signal] blocks in
  directions.css once a colour is picked.

  Swatches are real buttons with real labels — even a throwaway tool shouldn't
  be keyboard-hostile, and doing it properly takes no longer.
*/

const SIGNALS = [
  { id: 'vermilion', label: 'Vermilion', swatch: '#ff5232', note: 'hot' },
  { id: 'cobalt', label: 'Cobalt', swatch: '#5c7cff', note: 'electric blue' },
  { id: 'ice', label: 'Ice', swatch: '#6ed8ff', note: 'cold light' },
  { id: 'sun', label: 'Sun', swatch: '#ffd9a0', note: 'daylight' },
  { id: 'acid', label: 'Acid', swatch: '#d6f84c', note: 'the old lime' },
];
---

<aside
  class="fixed right-4 bottom-4 z-50 rounded-full border border-edge bg-surface-raised/95 px-3 py-2 backdrop-blur-md"
  data-signal-picker
>
  <div class="flex items-center gap-3">
    <p class="hidden font-body text-2xs tracking-widest text-fg-faint uppercase sm:block">
      Hover colour
    </p>
    <ul class="flex items-center gap-1.5">
      {
        SIGNALS.map((signal) => (
          <li>
            <button
              type="button"
              data-signal-choice={signal.id}
              title={`${signal.label} — ${signal.note}`}
              class="block h-7 w-7 rounded-full border-2 border-transparent transition-soft hover:scale-110 aria-[pressed=true]:border-fg-bright"
              style={`background:${signal.swatch}`}
              aria-pressed="false"
            >
              <span class="sr-only">
                {signal.label} — {signal.note}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</aside>

<script>
  /*
    Sets [data-signal] on <html>, which the variant blocks in directions.css
    hang off. The choice persists across navigation, so comparing the hero
    against the work list below it doesn't reset the colour.
  */
  const KEY = 'prototype-signal';
  const DEFAULT = 'vermilion';

  const apply = (id: string) => {
    document.documentElement.setAttribute('data-signal', id);

    document.querySelectorAll<HTMLButtonElement>('[data-signal-choice]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.signalChoice === id));
    });

    try {
      sessionStorage.setItem(KEY, id);
    } catch {
      /* Private browsing. The picker still works, it just won't persist. */
    }
  };

  const setup = () => {
    const picker = document.querySelector('[data-signal-picker]');
    if (!picker || picker.hasAttribute('data-ready')) return;
    picker.setAttribute('data-ready', '');

    picker.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-signal-choice]');
      if (button?.dataset.signalChoice) apply(button.dataset.signalChoice);
    });
  };

  const restore = () => {
    let saved = DEFAULT;
    try {
      saved = sessionStorage.getItem(KEY) ?? DEFAULT;
    } catch {
      /* ignore */
    }
    apply(saved);
    setup();
  };

  restore();
  document.addEventListener('astro:page-load', restore);
</script>
