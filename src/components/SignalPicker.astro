---
/*
  TEMPORARY — signal-colour switcher.

  The palette is settled apart from one decision: the single colour the site
  carries, used for hover, focus, buttons and selection. This exists so that
  colour can be chosen by looking at it rather than by reading hex codes.

  Delete this component, its usage in src/pages/index.astro, and the
  [data-signal] blocks at the bottom of global.css once a colour is picked.

  Real buttons with real labels, because a throwaway tool being
  keyboard-hostile takes no less time than doing it properly.
*/

const SIGNALS = [
  { id: 'cobalt', label: 'Cobalt', swatch: '#5c7cff', note: 'electric blue' },
  { id: 'azure', label: 'Azure', swatch: '#3d9bff', note: 'bright sky blue' },
  { id: 'ice', label: 'Ice', swatch: '#6ed8ff', note: 'cold cyan' },
  { id: 'violet', label: 'Violet', swatch: '#9b6bff', note: 'electric purple' },
  { id: 'orchid', label: 'Orchid', swatch: '#ff5cc8', note: 'hot pink' },
  { id: 'periwinkle', label: 'Periwinkle', swatch: '#a5b4ff', note: 'pale blue-violet' },
  { id: 'steel', label: 'Steel', swatch: '#93a7c4', note: 'quiet blue-grey' },
  { id: 'bone', label: 'Bone', swatch: '#ffffff', note: 'no colour at all' },
];
---

<aside
  class="fixed right-4 bottom-4 z-50 rounded-full border border-edge bg-surface-raised/95 px-3 py-2 backdrop-blur-md"
  data-signal-picker
>
  <div class="flex items-center gap-3">
    <p class="hidden font-body text-2xs tracking-widest text-fg-faint uppercase sm:block">
      Hover colour
    </p>
    <ul class="flex items-center gap-1.5">
      {
        SIGNALS.map((signal) => (
          <li>
            <button
              type="button"
              data-signal-choice={signal.id}
              title={`${signal.label} — ${signal.note}`}
              class="transition-soft block h-7 w-7 rounded-full border-2 border-transparent hover:scale-110 aria-[pressed=true]:border-fg-bright"
              style={`background:${signal.swatch}`}
              aria-pressed="false"
            >
              <span class="sr-only">
                {signal.label} — {signal.note}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</aside>

<script>
  /*
    Sets [data-signal] on <html>, which the candidate blocks in global.css hang
    off. The choice persists across navigation, so it survives clicking into
    another page and back.
  */
  const KEY = 'prototype-signal';
  const DEFAULT = 'cobalt';

  const apply = (id: string) => {
    document.documentElement.setAttribute('data-signal', id);

    document.querySelectorAll<HTMLButtonElement>('[data-signal-choice]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.signalChoice === id));
    });

    try {
      sessionStorage.setItem(KEY, id);
    } catch {
      /* Private browsing. The picker still works, it just won't persist. */
    }
  };

  const setup = () => {
    const picker = document.querySelector('[data-signal-picker]');
    if (!picker || picker.hasAttribute('data-ready')) return;
    picker.setAttribute('data-ready', '');

    picker.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-signal-choice]');
      if (button?.dataset.signalChoice) apply(button.dataset.signalChoice);
    });
  };

  const restore = () => {
    let saved = DEFAULT;
    try {
      saved = sessionStorage.getItem(KEY) ?? DEFAULT;
    } catch {
      /* ignore */
    }
    apply(saved);
    setup();
  };

  restore();
  document.addEventListener('astro:page-load', restore);
</script>
