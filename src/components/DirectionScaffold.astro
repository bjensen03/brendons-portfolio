---
import Section from './Section.astro';

/*
  The section that follows each prototype hero.

  Its job is to answer "does this direction survive contact with ordinary
  content?" — a hero can carry almost any look for one screen, but a work card,
  a paragraph and a button are where a direction either holds together or falls
  apart. Same markup in all three, so the only variable is the tokens.
*/

interface Props {
  name: string;
  idea: string;
}

const { name, idea } = Astro.props;

const work = [
  { client: 'ProLook Sports', outcome: 'Rebuilt the marketing front end', year: '2026' },
  { client: 'Lincoln Academy', outcome: 'Full site revamp for a K–9 charter', year: '2026' },
  { client: 'Placeholder', outcome: 'Your third case study goes here', year: '2025' },
];
---

<Section surface="base" width="wide" revealGroup>
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <h2
      class="font-display text-3xl md:text-4xl"
      style="letter-spacing: var(--tracking-display);"
      data-reveal
    >
      Selected work
    </h2>
    <p class="font-body text-2xs tracking-widest text-fg-faint uppercase" data-reveal>
      Direction: {name}
    </p>
  </div>

  <ul class="mt-10 divide-y divide-edge border-y border-edge">
    {
      work.map((item) => (
        <li data-reveal>
          <a
            href="/work/"
            class="transition-soft group grid gap-2 py-6 sm:grid-cols-[1fr_2fr_auto] sm:items-baseline sm:gap-8"
          >
            <span class="font-display text-xl text-fg-bright group-hover:text-signal">
              {item.client}
            </span>
            <span class="font-body text-base text-fg-muted">{item.outcome}</span>
            <span class="font-body text-2xs tracking-widest text-fg-faint uppercase">
              {item.year}
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="mt-14 grid gap-10 md:grid-cols-2">
    <p class="max-w-measure font-body text-lg text-fg-muted" data-reveal>{idea}</p>
    <div class="flex flex-wrap items-start gap-3 md:justify-end" data-reveal>
      <a
        href="/directions/"
        class="transition-soft inline-flex items-center rounded-full bg-signal px-6 py-3 font-body text-sm text-surface hover:bg-signal-bright"
      >
        Compare directions
      </a>
      <a
        href="/"
        class="transition-soft inline-flex items-center rounded-full border border-edge-strong px-6 py-3 font-body text-sm text-fg hover:border-signal hover:text-signal"
      >
        Original palette
      </a>
    </div>
  </div>
</Section>
