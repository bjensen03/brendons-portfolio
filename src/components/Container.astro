---
/*
  Horizontal container. Three widths, because three is all this site needs:
  `measure` for reading, `content` for most layouts, `wide` for full-bleed-ish
  work grids.
*/

interface Props {
  width?: 'measure' | 'content' | 'wide';
  class?: string;
}

const { width = 'content', class: className = '' } = Astro.props;

const widths = {
  measure: 'max-w-measure',
  content: 'max-w-content',
  wide: 'max-w-wide',
} as const;
---

<div class:list={['mx-auto w-full px-gutter', widths[width], className]}>
  <slot />
</div>
