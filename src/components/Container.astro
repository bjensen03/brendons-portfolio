---
/*
  Horizontal container. One width: full. Content spans the viewport minus
  --grid-margin on each side (the `container-bleed` utility in global.css),
  the same as every section on the home page. Running copy inside it keeps
  its own measure (`max-w-measure`); the container never caps the page.
*/

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['container-bleed', className]}>
  <slot />
</div>
