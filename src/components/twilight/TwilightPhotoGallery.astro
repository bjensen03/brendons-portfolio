---
import { Image, getImage } from 'astro:assets';
import { GALLERY_GROUPS, GALLERY_PHOTOS, type GalleryPhoto } from './gallery-data';
import { longestWordEm } from '../../lib/display-fit';

/*
  Every photo, once (/twilight-trekkers/, "The gallery"). 136 photographs
  from the library in seven groups, each opening in a lightbox.

  Tabs: Best picks (the 20 Best-tier photos) first and open by default,
  then one tab per group with its count. Only the open tab's panel is
  shown; the others are display: none, so their lazy images aren't
  requested until the tab is opened. Without JavaScript there are no tabs:
  every group shows, stacked, and the Best picks panel (a repeat) is left
  out. The lightbox steps through the open tab's photos only.

  Layout, per panel:
    - The big tiles (Best picks with a large enough source, see
      gallery-data.ts) lead, side by side at one height (a justified row:
      each grows in proportion to its aspect ratio from a zero basis, so
      they share a height and fill the width exactly), split into rows of
      about BIG_SPLIT_AR when there are many (Best picks). When they're too
      few to fill a row at a sensible height (combined ratio under
      BIG_ROW_AR), the label sits in the row beside them instead of above,
      so the row is full rather than over-tall.
    - The rest, in justified rows fixed at build time, split so every row
      is about REST_ROW_AR heights wide: no short last row, no gaps.
  Phones and tablets: the big tiles go two to a row (landscape ones full
  width) and the rest become two (three on tablets) columns at their own
  proportions.

  Nothing is cropped (except a lone portrait big tile on phones, 4:5 on
  its focus point): every tile has its photo's aspect ratio, so no layout
  shift. Tiles are 400/800px webp (big ones up to 1200, never past the
  source), lazy and async. The lightbox image (1000/1600) is only
  requested when a photo is opened.
*/

const BIG_ROW_AR = 2.6;
const BIG_SPLIT_AR = 3.4;
const REST_ROW_AR = 5.5;

const FILES = import.meta.glob<ImageMetadata>(
  '../../content/projects/images/twilight-trekkers/library/*/*.webp',
  { eager: true, import: 'default' },
);
const imageFor = (f: string): ImageMetadata => {
  const img = FILES[`../../content/projects/images/twilight-trekkers/library/${f}`];
  if (!img) throw new Error(`Gallery photo not found: ${f}`);
  return img;
};

/* Contiguous split into rows of about `target` ratio each, with ratio sums
   as even as possible. Greedy on cumulative ratio, which is exact enough
   here and linear. */
const splitRows = <T extends { ar: number }>(items: T[], target = REST_ROW_AR): T[][] => {
  if (!items.length) return [];
  const total = items.reduce((s, i) => s + i.ar, 0);
  const k = Math.max(1, Math.round(total / target));
  const rows: T[][] = [];
  let acc = 0;
  let row: T[] = [];
  for (const it of items) {
    const mid = acc + it.ar / 2;
    const goal = ((rows.length + 1) * total) / k;
    if (row.length && mid > goal && rows.length < k - 1) {
      rows.push(row);
      row = [];
    }
    row.push(it);
    acc += it.ar;
  }
  rows.push(row);
  return rows;
};

type Tile = GalleryPhoto & { ar: number; img: ImageMetadata; full: string; fullSm: string; index: number; group: string };

const groupLabel = (f: string) => GALLERY_GROUPS.find((g) => f.startsWith(`${g.id}/`))?.label ?? '';
const tileFor = async (p: GalleryPhoto): Promise<Tile> => {
  const img = imageFor(p.f);
  const [lg, sm] = await Promise.all([
    getImage({ src: img, width: Math.min(1600, img.width), format: 'webp' }),
    getImage({ src: img, width: Math.min(1000, img.width), format: 'webp' }),
  ]);
  return { ...p, ar: p.w / p.h, img, full: lg.src, fullSm: sm.src, index: 0, group: groupLabel(p.f) };
};

const layout = (id: string, label: string, tab: string, tiles: Tile[]) => {
  const big = tiles.filter((t) => t.big);
  /* Phones: portrait big tiles go two to a row; a portrait left without a
     partner is shown full width, cropped to 4:5 on its focus point. */
  const portraits = big.filter((t) => t.ar < 1);
  const solo = portraits.length % 2 === 1 ? portraits[portraits.length - 1] : undefined;
  const rest = tiles.filter((t) => !t.big);
  const bigAr = big.reduce((s, t) => s + t.ar, 0);
  const bigRows = bigAr > BIG_SPLIT_AR * 1.5 ? splitRows(big, BIG_SPLIT_AR) : big.length ? [big] : [];
  const rows = splitRows(rest);
  /* Lightbox order = reading order within the panel. */
  [...bigRows.flat(), ...rows.flat()].forEach((t, i) => (t.index = i));
  return {
    id,
    label,
    tab,
    count: tiles.length,
    bigRows,
    bigAr,
    solo,
    labelInRow: bigRows.length === 1 && bigAr < BIG_ROW_AR,
    rows,
  };
};

const groups = await Promise.all(
  GALLERY_GROUPS.map(async (g) =>
    layout(g.id, g.label, g.tab, await Promise.all(GALLERY_PHOTOS.filter((p) => p.f.startsWith(`${g.id}/`)).map(tileFor))),
  ),
);
const best = layout('best', 'Best picks', 'Best picks', await Promise.all(GALLERY_PHOTOS.filter((p) => p.best).map(tileFor)));
const panels = [best, ...groups];
const total = groups.reduce((s, g) => s + g.count, 0);

const widths = (t: Tile, big: boolean) => [400, 800, ...(big ? [1200] : [])].filter((w) => w <= t.img.width);
---

<section class="cs-sec tg" aria-labelledby="tg-title" data-tg>
  <div class="container-bleed">
    <h2 id="tg-title" class="text-section text-fg" data-split>The gallery</h2>
    <p class="mt-stack max-w-measure text-body text-fg-muted" data-reveal>
      Every photo in our library, once each: {total}, grouped by the kind of place. Tap one to see it larger.
    </p>

    <div class="tg-tabs" data-reveal>
      <div class="tg-tablist" role="tablist" aria-label="Photo groups" data-tg-tablist>
        {
          panels.map((p, i) => (
            <button
              type="button"
              role="tab"
              id={`tg-tab-${p.id}`}
              class="tg-tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`tg-panel-${p.id}`}
              tabindex={i === 0 ? 0 : -1}
              data-tg-tab={p.id}
            >
              {p.tab}
              <span class="tg-tab__count tabular-nums">{p.count}</span>
            </button>
          ))
        }
      </div>
    </div>

    {
      panels.map((g, i) => (
        <div
          class:list={['tg-group tg-panel', i === 0 && 'is-active', g.id === 'best' && 'tg-panel--best']}
          id={`tg-panel-${g.id}`}
          role="tabpanel"
          aria-labelledby={`tg-tab-${g.id}`}
          data-tg-panel={g.id}
        >
          {!g.labelInRow && (
            <h3 id={`tg-${g.id}`} class="tg-label">
              <span class="text-sub text-fg">{g.label}</span>
              <span class="tg-count text-body text-fg-muted">{g.count} photos</span>
            </h3>
          )}

          {g.bigRows.length > 0 && (
            <div class:list={['tg-big', g.labelInRow && 'tg-big--label']}>
              {g.bigRows.map((row, r) => (
                <div class="tg-bigrow">
                  {r === 0 && g.labelInRow && (
                    <h3
                      id={`tg-${g.id}`}
                      class="tg-label tg-label--row"
                      style={`--grow: ${Math.max(0.9, BIG_ROW_AR - g.bigAr).toFixed(3)}; --fit: ${longestWordEm(g.label)}`}
                    >
                      <span class="text-heading text-fg">{g.label}</span>
                      <span class="tg-count text-body text-fg-muted">{g.count} photos</span>
                    </h3>
                  )}
                  {row.map((t) => (
                    <button
                      type="button"
                      class:list={['tg-tile', t.ar >= 1 && 'tg-tile--wide', t === g.solo && 'tg-tile--solo']}
                      style={`--ar: ${t.ar.toFixed(4)}; --focus: ${t.focus ?? '50% 50%'}; aspect-ratio: ${t.w} / ${t.h}`}
                      aria-haspopup="dialog"
                      data-tg-tile={t.index}
                      data-full={t.full}
                      data-full-sm={t.fullSm}
                      data-w={t.w}
                      data-h={t.h}
                      data-group={t.group}
                    >
                      <Image
                        src={t.img}
                        alt={t.alt}
                        widths={widths(t, true)}
                        sizes="(min-width: 64rem) 45vw, 92vw"
                        format="webp"
                        loading="lazy"
                        decoding="async"
                      />
                    </button>
                  ))}
                </div>
              ))}
            </div>
          )}

          <div class="tg-rest">
            {g.rows.map((row) => (
              <div class="tg-row">
                {row.map((t) => (
                  <button
                    type="button"
                    class="tg-tile"
                    style={`--ar: ${t.ar.toFixed(4)}; aspect-ratio: ${t.w} / ${t.h}`}
                    aria-haspopup="dialog"
                    data-tg-tile={t.index}
                    data-full={t.full}
                    data-full-sm={t.fullSm}
                    data-w={t.w}
                    data-h={t.h}
                    data-group={t.group}
                  >
                    <Image
                      src={t.img}
                      alt={t.alt}
                      widths={widths(t, false)}
                      sizes="(min-width: 64rem) 22vw, (min-width: 48rem) 31vw, 46vw"
                      format="webp"
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  {/* The lightbox. A native modal dialog: focus stays inside while it's
      open, Esc closes it, and the page behind is inert. */}
  <dialog class="tg-lb" data-tone="dark" aria-label="Photo viewer" data-tg-lb data-lenis-prevent>
    <div class="tg-lb__stage" data-tg-stage>
      <img class="tg-lb__img" alt="" decoding="async" data-tg-img />
    </div>
    <div class="tg-lb__bar">
      <p class="tg-lb__caption">
        <span class="block text-body text-fg" data-tg-alt></span>
        <span class="mt-1 block text-small text-fg-muted">
          <span data-tg-group></span> · <span class="tabular-nums" data-tg-count></span> of <span class="tabular-nums" data-tg-total>{best.count}</span>
        </span>
      </p>
      <div class="tg-lb__nav">
        <button type="button" class="tg-lb__btn" data-tg-prev>
          <span aria-hidden="true">←</span> Previous
        </button>
        <button type="button" class="tg-lb__btn" data-tg-next>
          Next <span aria-hidden="true">→</span>
        </button>
        <button type="button" class="tg-lb__btn tg-lb__close" data-tg-close>Close</button>
      </div>
    </div>
  </dialog>
</section>

<style>
  /* ── Tabs ───────────────────────────────────────────────────────────
     Bordered words in a row, the open one filled tan. Phones: one row
     that scrolls sideways, running to the screen edge so the cut-off tab
     says there's more. From tablets up the row wraps. */
  .tg-tabs {
    margin-top: var(--spacing-block);
  }
  .tg-tablist {
    display: flex;
    gap: 0.5rem;
    margin-inline: calc(-1 * var(--grid-margin));
    padding: 2px var(--grid-margin);
    overflow-x: auto;
    scroll-padding-inline: var(--grid-margin);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .tg-tablist::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 48rem) {
    .tg-tablist {
      flex-wrap: wrap;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
  }
  .tg-tab {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--color-edge-strong);
    border-radius: var(--radius-control);
    color: var(--color-fg);
    font-size: var(--text-small);
    font-weight: 500;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out-soft),
      border-color var(--duration-fast) var(--ease-out-soft),
      color var(--duration-fast) var(--ease-out-soft);
  }
  .tg-tab__count {
    color: var(--color-fg-muted);
    font-weight: 400;
  }
  @media (hover: hover) {
    .tg-tab:hover {
      background: var(--color-surface-raised);
    }
  }
  .tg-tab[aria-selected='true'] {
    background: var(--color-accent-fill);
    border-color: var(--color-accent-fill);
    color: var(--color-on-accent);
  }
  .tg-tab[aria-selected='true'] .tg-tab__count {
    color: inherit;
    opacity: 0.75;
  }
  .tg-tab:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  /* No script, no tabs: every group shows stacked, without the Best picks
     repeat. */
  :global(html:not(.js)) .tg-tabs,
  :global(html:not(.js)) .tg-panel--best {
    display: none;
  }

  .tg-group {
    margin-top: var(--spacing-block);
  }
  /* With script, only the open panel shows (from first paint: the server
     marks Best picks open). */
  :global(html.js) .tg-panel {
    margin-top: var(--spacing-stack);
  }
  :global(html.js) .tg-panel:not(.is-active) {
    display: none;
  }
  .tg-panel:focus {
    outline: none;
  }
  :global(html.motion-ok) .tg-panel.is-entering {
    animation: tg-in var(--duration-base) var(--ease-out-soft) both;
  }
  @keyframes tg-in {
    from {
      opacity: 0;
    }
  }
  .tg-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.75rem;
    row-gap: 0.25rem;
    margin-bottom: 1rem;
    font: inherit;
  }

  /* Tiles: the photo at its own proportions, nothing cropped. */
  .tg-tile {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-control);
    background: var(--color-surface-raised);
    cursor: zoom-in;
  }
  .tg-tile :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--duration-slow) var(--ease-out-soft);
  }
  @media (hover: hover) {
    .tg-tile:hover :global(img) {
      scale: 1.03;
    }
  }
  .tg-tile:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* ── Phones and tablets ─────────────────────────────────────────────── */
  .tg-big {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-flow: row dense;
    gap: 0.375rem;
    margin-bottom: 0.375rem;
  }
  .tg-bigrow {
    display: contents;
  }
  .tg-big .tg-tile {
    width: 100%;
  }
  .tg-big .tg-tile--wide,
  .tg-big .tg-tile--solo,
  .tg-big .tg-label {
    grid-column: 1 / -1;
  }
  @media (max-width: 63.999rem) {
    .tg-big .tg-tile--solo {
      aspect-ratio: 4 / 5 !important;
    }
    .tg-big .tg-tile--solo :global(img) {
      object-position: var(--focus);
    }
  }
  .tg-label--row {
    display: flex;
    margin-bottom: 0.625rem;
  }
  .tg-label--row .text-heading {
    font-family: var(--font-body);
    font-stretch: normal;
    text-transform: none;
    font-size: var(--text-title);
    font-weight: var(--text-title--font-weight);
    letter-spacing: var(--text-title--letter-spacing);
    line-height: var(--text-title--line-height);
  }
  .tg-rest {
    columns: 2;
    column-gap: 0.375rem;
  }
  @media (min-width: 48rem) {
    .tg-rest {
      columns: 3;
    }
  }
  .tg-row {
    display: contents;
  }
  .tg-rest .tg-tile {
    width: 100%;
    margin-bottom: 0.375rem;
    break-inside: avoid;
  }

  /* ── Desktop: justified rows ──────────────────────────────────────────── */
  @media (min-width: 64rem) {
    .tg-big {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
    }
    .tg-bigrow {
      display: flex;
      gap: 0.5rem;
    }
    .tg-big .tg-tile {
      flex: var(--ar) 1 0;
      width: auto;
      min-width: 0;
    }
    /* The label as part of the row: it takes what the photos leave, and
       sits at the top of that column. It is a size container, and the
       name is sized so its longest word (--fit, in em, from
       lib/display-fit) always fits the column's width: the heading step
       when there's room, smaller when the column is narrow (a small
       laptop or a half-width window). Words wrap; nothing is clipped or
       runs under the photos. */
    .tg-label--row {
      flex: var(--grow) 1 0;
      min-width: 14rem;
      flex-direction: column;
      justify-content: flex-start;
      align-items: flex-start;
      margin: 0;
      padding-right: var(--grid-gutter);
      container-type: inline-size;
    }
    .tg-label--row .text-heading {
      display: block;
      max-width: 100%;
      overflow-wrap: break-word;
      font-family: var(--font-display);
      font-stretch: var(--display-stretch);
      text-transform: var(--display-case);
      font-size: min(var(--text-heading), calc(100cqi / (var(--fit) * 1.06)));
      font-weight: var(--text-heading--font-weight);
      letter-spacing: var(--text-heading--letter-spacing);
      line-height: var(--text-heading--line-height);
    }
    .tg-label--row .tg-count {
      margin-top: 0.75rem;
    }
    .tg-rest {
      columns: auto;
    }
    .tg-row {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
    }
    .tg-rest .tg-tile {
      flex: var(--ar) 1 0;
      width: auto;
      min-width: 0;
      margin: 0;
    }
  }

  /* ── Lightbox ───────────────────────────────────────────────────────── */
  .tg-lb {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    /* A dark band at every brightness (data-tone="dark"). */
    background: var(--color-surface);
    color: var(--color-fg);
    overscroll-behavior: contain;
  }
  .tg-lb[open] {
    display: grid;
    grid-template-rows: 1fr auto;
  }
  .tg-lb::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  .tg-lb__stage {
    position: relative;
    min-height: 0;
    touch-action: pan-y;
  }
  /* Centred in the space above the bar, as large as fits, never cropped. */
  .tg-lb__img {
    position: absolute;
    inset: 1rem var(--grid-margin) 0;
    margin: auto;
    max-width: calc(100% - 2 * var(--grid-margin));
    max-height: calc(100% - 1rem);
    width: auto;
    height: auto;
    border-radius: var(--radius-control);
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }
  .tg-lb__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 1rem var(--grid-margin) max(1rem, env(safe-area-inset-bottom));
  }
  .tg-lb__caption {
    flex: 1 1 18rem;
    max-width: 60ch;
  }
  .tg-lb__nav {
    display: flex;
    gap: 0.5rem;
  }
  .tg-lb__btn {
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--color-edge-strong);
    border-radius: var(--radius-control);
    color: var(--color-fg);
    font-size: var(--text-small);
    font-weight: 500;
    white-space: nowrap;
  }
  .tg-lb__btn:hover {
    background: var(--color-surface-raised);
  }
  .tg-lb__btn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .tg-lb__close {
    background: var(--color-accent-fill);
    border-color: var(--color-accent-fill);
    color: var(--color-on-accent);
  }
  .tg-lb__close:hover {
    background: var(--color-accent-fill);
    filter: brightness(1.06);
  }
  @media (max-width: 47.999rem) {
    .tg-lb__nav {
      width: 100%;
    }
    .tg-lb__nav .tg-lb__btn {
      flex: 1;
      padding: 0 0.5rem;
    }
  }
</style>

<script>
  import { registerMotion, motion, prefersReducedMotion } from '../../scripts/motion';

  /* Tabs and the lightbox. Registered with reduced: true: neither is
     motion (the panel fade is CSS, behind motion-ok). */
  const gallery = () => {
    const root = document.querySelector<HTMLElement>('[data-tg]');
    const lb = root?.querySelector<HTMLDialogElement>('[data-tg-lb]');
    const tablist = root?.querySelector<HTMLElement>('[data-tg-tablist]');
    if (!root || !lb || !tablist) return;
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[data-tg-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-tg-panel]'));
    const img = lb.querySelector<HTMLImageElement>('[data-tg-img]')!;
    const altEl = lb.querySelector<HTMLElement>('[data-tg-alt]')!;
    const groupEl = lb.querySelector<HTMLElement>('[data-tg-group]')!;
    const countEl = lb.querySelector<HTMLElement>('[data-tg-count]')!;
    const totalEl = lb.querySelector<HTMLElement>('[data-tg-total]')!;
    const stage = lb.querySelector<HTMLElement>('[data-tg-stage]')!;

    /* The open panel's tiles, in reading order: the lightbox steps through
       these only. */
    let tiles: HTMLButtonElement[] = [];
    const collect = (panel: HTMLElement) => {
      tiles = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-tg-tile]')).sort(
        (a, b) => Number(a.dataset.tgTile) - Number(b.dataset.tgTile),
      );
      totalEl.textContent = String(tiles.length);
    };

    /* ── Tabs ── */
    let refreshTimer = 0;
    const select = (tab: HTMLButtonElement, focus: boolean) => {
      const id = tab.dataset.tgTab;
      const panel = panels.find((p) => p.dataset.tgPanel === id);
      if (!panel) return;
      const changed = tab.getAttribute('aria-selected') !== 'true';
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      if (focus) tab.focus({ preventScroll: true });
      /* Keep the open tab in view in the sideways-scrolling row. */
      const tr = tab.getBoundingClientRect();
      const lr = tablist.getBoundingClientRect();
      if (tr.left < lr.left || tr.right > lr.right) {
        tablist.scrollTo({ left: tablist.scrollLeft + tr.left - lr.left - 20, behavior: prefersReducedMotion() ? 'auto' : 'smooth' });
      }
      if (!changed) return;
      panels.forEach((p) => {
        const on = p === panel;
        p.classList.toggle('is-active', on);
        p.classList.toggle('is-entering', on);
      });
      collect(panel);
      /* If the tabs had scrolled off the top, bring them back so the new
         panel starts in view (the old one may have been much taller). */
      const top = tablist.getBoundingClientRect().top;
      if (top < 0) {
        const y = window.scrollY + top - 96;
        if (motion.lenis) motion.lenis.scrollTo(y, { immediate: true, force: true });
        else window.scrollTo(0, y);
      }
      /* The page below changed height. */
      window.clearTimeout(refreshTimer);
      refreshTimer = window.setTimeout(() => motion.ScrollTrigger.refresh(), 60);
    };
    const onTabClick = (e: Event) => select(e.currentTarget as HTMLButtonElement, false);
    const onTabKey = (e: KeyboardEvent) => {
      const i = tabs.indexOf(e.currentTarget as HTMLButtonElement);
      let j = -1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') j = (i + 1) % tabs.length;
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') j = (i - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') j = 0;
      else if (e.key === 'End') j = tabs.length - 1;
      if (j < 0) return;
      e.preventDefault();
      select(tabs[j], true);
    };
    const onAnimEnd = (e: AnimationEvent) => (e.target as HTMLElement).classList.remove('is-entering');

    collect(panels.find((p) => p.classList.contains('is-active')) ?? panels[0]);

    /* ── Lightbox ── */
    let current = 0;
    let opener: HTMLButtonElement | null = null;

    const show = (i: number) => {
      current = (i + tiles.length) % tiles.length;
      const t = tiles[current];
      const thumb = t.querySelector('img');
      img.width = Number(t.dataset.w);
      img.height = Number(t.dataset.h);
      img.alt = thumb?.alt ?? '';
      img.sizes = '100vw';
      img.srcset = `${t.dataset.fullSm} 1000w, ${t.dataset.full} 1600w`;
      img.src = t.dataset.full ?? '';
      altEl.textContent = thumb?.alt ?? '';
      groupEl.textContent = t.dataset.group ?? '';
      countEl.textContent = String(current + 1);
    };

    const open = (t: HTMLButtonElement) => {
      opener = t;
      const panel = t.closest<HTMLElement>('[data-tg-panel]');
      if (panel) collect(panel);
      show(Math.max(0, tiles.indexOf(t)));
      motion.lenis?.stop();
      lb.showModal();
      lb.querySelector<HTMLButtonElement>('[data-tg-next]')?.focus();
    };
    const onClose = () => {
      motion.lenis?.start();
      /* Back to the tile of the photo you were looking at. */
      (tiles[current] ?? opener)?.focus();
    };

    const onTile = (e: Event) => open(e.currentTarget as HTMLButtonElement);
    const prev = () => show(current - 1);
    const next = () => show(current + 1);
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prev();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        next();
      }
    };
    /* A tap on the dark area around the photo closes it. */
    const onStageClick = (e: MouseEvent) => {
      if (e.target === stage) lb.close();
    };

    /* Swipe on phones: a mostly sideways drag of 40px or more. */
    let sx = 0;
    let sy = 0;
    let tracking = false;
    const down = (e: PointerEvent) => {
      if (e.pointerType === 'mouse') return;
      tracking = true;
      sx = e.clientX;
      sy = e.clientY;
    };
    const up = (e: PointerEvent) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - sx;
      const dy = e.clientY - sy;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) (dx < 0 ? next : prev)();
    };
    const cancel = () => (tracking = false);

    const allTiles = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tg-tile]'));
    const prevBtn = lb.querySelector('[data-tg-prev]')!;
    const nextBtn = lb.querySelector('[data-tg-next]')!;
    const closeBtn = lb.querySelector('[data-tg-close]')!;
    const close = () => lb.close();

    tabs.forEach((t) => {
      t.addEventListener('click', onTabClick);
      t.addEventListener('keydown', onTabKey);
    });
    panels.forEach((p) => p.addEventListener('animationend', onAnimEnd));
    allTiles.forEach((t) => t.addEventListener('click', onTile));
    prevBtn.addEventListener('click', prev);
    nextBtn.addEventListener('click', next);
    closeBtn.addEventListener('click', close);
    lb.addEventListener('keydown', onKey);
    lb.addEventListener('close', onClose);
    stage.addEventListener('click', onStageClick);
    stage.addEventListener('pointerdown', down);
    stage.addEventListener('pointerup', up);
    stage.addEventListener('pointercancel', cancel);

    return () => {
      window.clearTimeout(refreshTimer);
      tabs.forEach((t) => {
        t.removeEventListener('click', onTabClick);
        t.removeEventListener('keydown', onTabKey);
      });
      panels.forEach((p) => p.removeEventListener('animationend', onAnimEnd));
      allTiles.forEach((t) => t.removeEventListener('click', onTile));
      prevBtn.removeEventListener('click', prev);
      nextBtn.removeEventListener('click', next);
      closeBtn.removeEventListener('click', close);
      lb.removeEventListener('keydown', onKey);
      lb.removeEventListener('close', onClose);
      stage.removeEventListener('click', onStageClick);
      stage.removeEventListener('pointerdown', down);
      stage.removeEventListener('pointerup', up);
      stage.removeEventListener('pointercancel', cancel);
      if (lb.open) lb.close();
    };
  };

  registerMotion(gallery, { reduced: true });
</script>
