---
/*
  A single result. Used inside the Result section of a case study.

  `source` is required rather than optional on purpose: a number without a
  provenance is a claim, not evidence, and someone will eventually ask where it
  came from. "Google Analytics, Jan–Jun 2026" is a fine answer. "Estimated" is
  not — if it's an estimate, write the qualitative result instead.

  Sits on the ink band Stats provides, so the colours here are the inverse of
  the rest of the page.
*/

interface Props {
  value: string;
  label: string;
  source: string;
}

const { value, label, source } = Astro.props;
---

<div class="flex flex-col border-t border-edge pt-6" data-stat>
  <p class="font-mono text-label tracking-widest text-fg-muted uppercase">{label}</p>

  {/* The value is the point of the whole block, so it gets display sizing and
      the tightest tracking the face will take. */}
  <p
    class="mt-5 font-display text-display leading-[0.95] font-extrabold text-fg"
    style="letter-spacing: var(--tracking-display);"
    data-stat-value
  >
    {value}
  </p>

  <p class="mt-5 max-w-[34ch] font-body text-small leading-relaxed text-fg-muted">{source}</p>
</div>

<script>
  import { registerMotion, prefersReducedMotion, motion, ease, revealStart } from '../../scripts/motion';

  /*
    The numbers rise into place as the band arrives. Not a count-up: these are
    ratios and arrows ("8/8", "3 → 1") as often as they are integers, and
    animating a digit that was never a quantity looks broken.
  */
  registerMotion(() => {
    const values = Array.from(document.querySelectorAll<HTMLElement>('[data-stat-value]'));
    const band = document.querySelector<HTMLElement>('[data-stats]');
    if (values.length === 0 || !band || prefersReducedMotion()) return;

    const gsap = motion.gsap;

    const tween = gsap.from(values, {
      yPercent: 55,
      autoAlpha: 0,
      duration: 0.75,
      stagger: 0.09,
      ease: ease.outStrata,
      scrollTrigger: { trigger: band, start: revealStart('top 78%'), once: true },
    });

    return () => {
      tween.scrollTrigger?.kill();
      tween.kill();
      gsap.set(values, { clearProps: 'transform,opacity,visibility' });
    };
  });
</script>
