---
/*
  Named rows (list:<id> on a study, and the brands on the Twilight Trekkers
  page): one ruled, full-width row per item, the name large on the left and
  its line beside it. Text only, so nothing leaves a column half empty.

  Items may carry a `group`: a small label row opens each run of the same
  group (the Twilight brands: Brands, Hotels & stays, Excursions). An item
  with no line shows the name alone.
*/

interface Props {
  id: string;
  heading: string;
  introHtml?: string;
  items: Array<{ name: string; body: string; group?: string }>;
  headingClass?: string;
}

const { id, heading, introHtml, items, headingClass = 'cs-h2' } = Astro.props;
const base = `lr-${id}`;
---

<section class="cs-sec lr" aria-labelledby={`${base}-title`}>
  <div class="container-bleed">
    <h2 id={`${base}-title`} class={headingClass} data-split>{heading}</h2>
    {introHtml && <div class="cs-prose cs-intro" set:html={introHtml} data-reveal />}

    <ul role="list" class="lr-list" data-reveal-group>
      {
        items.map((it, i) => (
          <>
            {it.group && it.group !== items[i - 1]?.group && (
              <li class="lr-group text-small text-fg-muted" data-reveal>{it.group}</li>
            )}
            <li class="lr-row" data-reveal>
              <h3 class="lr-name text-sub text-fg">{it.name}</h3>
              {it.body && <p class="lr-body text-body text-fg-muted">{it.body}</p>}
            </li>
          </>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .lr-list {
    margin-top: var(--spacing-block);
    list-style: none;
    padding: 0;
  }
  .lr-row {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    row-gap: 0.5rem;
    align-items: baseline;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-edge);
  }
  .lr-group {
    padding-top: var(--spacing-block);
    padding-bottom: 0.75rem;
  }
  .lr-group:first-child {
    padding-top: 0;
  }
  .lr-row:last-child {
    border-bottom: 1px solid var(--color-edge);
  }
  .lr-name,
  .lr-body {
    grid-column: 1 / -1;
    min-width: 0;
  }
  .lr-body {
    max-width: var(--container-measure);
  }
  @media (min-width: 48rem) {
    .lr-name {
      grid-column: 1 / span 2;
    }
    .lr-body {
      grid-column: 3 / -1;
    }
  }
  @media (min-width: 64rem) {
    .lr-name {
      grid-column: 1 / span 4;
    }
    .lr-body {
      grid-column: 6 / span 7;
    }
  }
</style>
