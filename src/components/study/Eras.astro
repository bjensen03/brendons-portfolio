---
import BrowserFrame from './BrowserFrame.astro';
import StudyImage from './StudyImage.astro';

/*
  Eras — the same website over time.

  At 1024+ with motion on, study-motion.ts (erasStage) sets data-ready and
  the run becomes one sticky screen: the year large on the left, the era's
  title and text under it, and a single browser window on the right. Every
  screenshot is a step; scrolling walks through them, wiping each into the
  window, and the year rolls over when the era changes. The years are real
  buttons that jump to their era.

  Everywhere else — phones, tablets, reduced motion, no JS — it is a plain
  stacked list: year, title, text, then that era's screenshots. Only one of
  the two layouts is ever displayed, so nothing is announced twice.
*/

interface Era {
  year: string;
  title: string;
  html: string;
  url?: string;
  shots: Array<{ src: string; alt: string }>;
}

interface Props {
  heading: string;
  introHtml?: string;
  items: Era[];
}

const { heading, introHtml, items } = Astro.props;
/* The captures are 1440 × ~675 CSS px; the window matches so nothing is cropped. */
const RATIO = '2880 / 1350';
const steps = items.flatMap((era, e) => era.shots.map((shot, s) => ({ ...shot, era: e, first: s === 0 })));
---

<section class="cs-sec er" aria-labelledby="eras-title" data-eras style={`--steps: ${steps.length}`}>
  <div class="container-bleed er-head">
    <h2 id="eras-title" class="cs-h2" data-split>{heading}</h2>
    {introHtml && <div class="cs-prose cs-intro" set:html={introHtml} data-reveal />}
  </div>

  {/* Pinned stage (1024+, motion on) */}
  <div class="er-run" data-eras-run>
    <div class="er-pin">
      <div class="container-bleed er-grid">
        <div class="er-side">
          <p class="er-year" aria-hidden="true">
            {items.map((era, i) => (
              <span class="er-year__mask"><span class="er-year__num" data-eras-year={i}>{era.year}</span></span>
            ))}
          </p>

          <ol class="cs-index er-nav" aria-label="Versions of the site">
            {items.map((era, i) => (
              <li>
                <button type="button" class="cs-index__item text-small" data-eras-jump={i}>
                  <span class="font-medium">{era.year}</span> <span>· {era.title}</span>
                </button>
              </li>
            ))}
          </ol>

          <div class="er-texts">
            {items.map((era, i) => (
              <div class="er-text" data-eras-text={i}>
                <h3 class="text-sub text-fg">{era.title}</h3>
                <div class="cs-prose cs-prose--sm mt-4" set:html={era.html} />
              </div>
            ))}
          </div>

          <div class="er-progress" aria-hidden="true"><span data-eras-progress></span></div>
        </div>

        <div class="er-stage">
          <BrowserFrame url={items[0].url} ratio={RATIO} viewAttrs={{ 'data-eras-view': '' }}>
            {steps.map((step, i) => (
              <div class="er-slide" data-eras-slide={i} data-era={step.era}>
                <StudyImage src={step.src} alt={step.alt} sizes="(min-width: 64rem) 62vw, 100vw" fit="top" class="er-slide__pic" />
              </div>
            ))}
          </BrowserFrame>
        </div>
      </div>
    </div>
  </div>

  {/* Phones and tablets with JS: the year scrubber over the swipe track
      (erasMobile, mobile-motion.ts). */}
  <div class="container-bleed er-scrub" data-er-scrub>
    <div class="er-scrub__years">
      {items.map((era, i) => (
        <button type="button" class="er-scrub__year" aria-label={`${era.year}: ${era.title}`} aria-current={i === 0 ? 'true' : undefined} data-er-year={i}>
          {era.year}
        </button>
      ))}
    </div>
    <span class="er-scrub__line" aria-hidden="true"><span data-er-fill></span></span>
  </div>

  {/* Stacked (desktop reduced motion, no JS); a swipe track on phones and
      tablets */}
  <ol class="container-bleed er-stack" data-er-track data-lenis-prevent-horizontal>
    {
      items.map((era) => (
        <li class="er-stack__item" data-er-item>
          <div class="er-stack__text">
            <p class="er-stack__year" aria-hidden="true">{era.year}</p>
            <h3 class="mt-3 text-sub text-fg">
              <span class="sr-only">{era.year}: </span>
              {era.title}
            </h3>
            <div class="cs-prose mt-4" set:html={era.html} />
          </div>
          <div class="er-stack__shots">
            {era.shots.map((shot, s) => (
              <BrowserFrame url={s === 0 ? era.url : undefined} ratio={RATIO}>
                <StudyImage src={shot.src} alt={shot.alt} sizes="(min-width: 64rem) 58vw, 100vw" fit="top" class="er-slide__pic" />
              </BrowserFrame>
            ))}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .er-head {
    padding-bottom: var(--spacing-block);
  }

  .er-run {
    display: none;
  }

  .er-pin {
    position: sticky;
    top: 0;
    height: 100svh;
    padding-top: var(--spacing-nav);
    display: flex;
    align-items: center;
  }

  .er-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    align-items: center;
    /* Clear of the brightness rail on the right edge. */
    padding-inline-end: max(var(--grid-margin), 4rem);
  }

  .er-side {
    grid-column: 1 / span 4;
    min-width: 0;
  }

  .er-stage {
    grid-column: 5 / -1;
    min-width: 0;
  }

  /* Hold the window to what's left of the screen. */
  .er-stage :global(.cs-browser) {
    width: min(100%, calc((100svh - var(--spacing-nav) - 6rem) * 2880 / 1350));
    margin-left: auto;
  }

  .er-year {
    display: grid;
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: 900;
    font-size: min(var(--text-mega), 9.5vw);
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--color-fg);
    font-variant-numeric: tabular-nums;
  }

  .er-year__mask {
    grid-area: 1 / 1;
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .er-year__num {
    display: block;
  }

  .er-year__mask:not(:first-child) .er-year__num {
    visibility: hidden;
  }

  .er-nav {
    margin-top: 1.5rem;
  }

  .er-texts {
    display: grid;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-edge);
  }

  .er-text {
    grid-area: 1 / 1;
    visibility: hidden;
  }

  .er-text:first-child {
    visibility: visible;
  }

  .er-progress {
    margin-top: 1.75rem;
    height: 3px;
    background: var(--color-edge);
    border-radius: 2px;
    overflow: hidden;
  }

  .er-progress span {
    display: block;
    height: 100%;
    background: var(--color-accent-fill);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .er-slide {
    position: absolute;
    inset: 0;
    visibility: hidden;
    overflow: hidden;
  }

  .er-slide:first-child {
    visibility: visible;
  }

  :global(.er-slide__pic) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .er-slide :global(img) {
    will-change: transform;
  }

  @media (min-width: 64rem) {
    .er[data-ready] .er-run {
      display: block;
      height: calc(100svh + var(--steps) * 55svh);
    }
    .er[data-ready] .er-stack {
      display: none;
    }
  }

  /* Stacked */
  .er-stack {
    list-style: none;
    display: grid;
    gap: var(--spacing-block);
  }

  .er-stack__item {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    row-gap: var(--spacing-stack);
    padding-top: var(--spacing-stack);
    border-top: 1px solid var(--color-edge);
  }

  .er-stack__text,
  .er-stack__shots {
    grid-column: 1 / -1;
    min-width: 0;
  }

  .er-stack__shots {
    display: grid;
    gap: 1rem;
  }

  .er-stack__year {
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: 900;
    font-size: clamp(3.5rem, 2rem + 6vw, 7rem);
    line-height: 0.9;
    color: var(--color-fg);
  }

  @media (min-width: 64rem) {
    .er-stack__text {
      grid-column: 1 / span 4;
    }
    .er-stack__shots {
      grid-column: 6 / -1;
    }
  }

  .er-scrub {
    display: none;
  }

  /*
    ── Phones and tablets ─────────────────────────────────────────────────
    The versions of the site side by side on a snapping track: swipe from
    2022 to 2025 to 2026 and the screenshots land in the same spot, so the
    site visibly changes under your thumb. Above the track, the years are a
    scrubber: tap one to jump, and a tan line fills as you travel. The
    track's height follows the era on screen (erasMobile).
  */
  @media (max-width: 63.999rem) {
    :global(html.js) .er-head {
      padding-bottom: var(--spacing-stack);
    }
    :global(html.js) .er-scrub {
      display: block;
      position: sticky;
      top: var(--sticky-top, 0px);
      z-index: 5;
      padding-block: 0.5rem 0.75rem;
      background: var(--color-surface);
      transition: top var(--duration-base) var(--ease-out-soft);
    }
    .er-scrub__years {
      display: flex;
      justify-content: space-between;
    }
    .er-scrub__year {
      min-width: 2.75rem;
      min-height: 2.75rem;
      font-family: var(--font-display);
      font-stretch: var(--display-stretch);
      font-weight: 900;
      font-size: 1.375rem;
      letter-spacing: -0.02em;
      color: var(--color-fg-muted);
      cursor: pointer;
      transition:
        color var(--duration-base) var(--ease-out-soft),
        scale var(--duration-base) var(--ease-snap);
      transform-origin: 50% 70%;
    }
    .er-scrub__year:first-child {
      text-align: left;
      transform-origin: 0 70%;
    }
    .er-scrub__year:last-child {
      text-align: right;
      transform-origin: 100% 70%;
    }
    .er-scrub__year[aria-current='true'] {
      color: var(--color-fg);
      scale: 1.12;
    }
    .er-scrub__line {
      display: block;
      height: 3px;
      margin-top: 0.25rem;
      border-radius: 2px;
      background: var(--color-edge);
      overflow: hidden;
    }
    .er-scrub__line span {
      display: block;
      height: 100%;
      background: var(--color-accent-fill);
      transform: scaleX(var(--er-p, 0));
      transform-origin: 0 50%;
    }

    /* Positioned, so absolutely placed descendants (the screen-reader year
       in each title) are clipped by the track instead of widening the page. */
    :global(html.js) .er-stack {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: var(--grid-gutter);
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--grid-margin);
      scrollbar-width: none;
      transition: height var(--duration-base) var(--ease-out-soft);
    }
    :global(html.js) .er-stack::-webkit-scrollbar {
      display: none;
    }
    /* The gap between versions is wider than the page margin, so the next
       one never shows as a sliver down the right edge of a long era. */
    :global(html.js) .er-stack {
      gap: calc(2 * var(--grid-margin));
    }
    :global(html.js) .er-stack::after {
      content: '';
      flex: 0 0 1px;
      margin-left: calc(-1 * var(--grid-margin));
    }
    /* The scrubber above already names the version on screen; the big year
       under it said "Then" a second time. */
    :global(html.js) .er-stack__year {
      display: none;
    }
    :global(html.js) .er-stack__item {
      flex: 0 0 100%;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      border-top: 0;
      padding-top: var(--spacing-stack);
    }
    /* Screenshots first, then the story: swiping lands each version's
       screens in the same place. */
    :global(html.js) .er-stack__shots {
      order: 2;
    }
    :global(html.js) .er-stack__text {
      display: contents;
    }
    :global(html.js) .er-stack__text > * {
      grid-column: 1 / -1;
      min-width: 0;
    }
    :global(html.js) .er-stack__text > :not(.cs-prose) {
      order: 1;
    }
    :global(html.js) .er-stack__text > .cs-prose {
      order: 3;
      margin-top: 0;
    }
    :global(html.js) .er-stack__text > h3 {
      margin-top: 0;
    }
  }

  @media (max-width: 63.999rem) and (prefers-reduced-motion: reduce) {
    :global(html.js) .er-scrub,
    :global(html.js) .er-stack,
    .er-scrub__year {
      transition: none;
    }
  }
</style>
