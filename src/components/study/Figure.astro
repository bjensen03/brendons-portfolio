---
import { Image } from 'astro:assets';

/*
  Full-bleed image with a caption.

  Goes through Astro's image pipeline, so it emits AVIF/WebP at the right sizes
  rather than shipping the original. `alt` is required by the type — a decorative
  screenshot in a case study is almost always still carrying information.
*/

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** 'wide' breaks out of the reading measure. */
  width?: 'measure' | 'wide';
}

const { src, alt, caption, width = 'wide' } = Astro.props;
---

<figure class:list={['my-14', width === 'wide' && 'lg:-mx-24']}>
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1440, 1920]}
    sizes="(min-width: 1024px) 60rem, 100vw"
    class="w-full rounded-media border border-edge"
  />
  {
    caption && (
      <figcaption class="mt-4 font-body text-small text-fg-muted">{caption}</figcaption>
    )
  }
</figure>
