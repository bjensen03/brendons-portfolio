---
/*
  At a glance. Full-width rows, not a grid of tiles: the figure set large
  across the left seven columns, its label and note beside it. The figure
  counts up once on arrival (data-count reads the first number out of the
  text and puts the rest back), so "About 26 seconds to under 2 seconds"
  counts the 26 and leaves the words alone. Scope, not invented results —
  only what the yaml says.
*/

interface Props {
  items: Array<{ value: string; label: string; note?: string }>;
}

const { items } = Astro.props;
---

<section class="cs-sec" aria-labelledby="glance-title">
  <div class="container-bleed">
    <h2 id="glance-title" class="cs-h2" data-split>At a glance</h2>

    <ul class="gl" data-reveal-group>
      {
        items.map((g) => (
          <li class="gl-row" data-reveal>
            <p class="gl-value" data-count>{g.value}</p>
            <div class="gl-text">
              <p class="text-body font-medium text-fg">{g.label}</p>
              {g.note && <p class="mt-2 max-w-measure text-small text-fg-muted">{g.note}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gl {
    margin-top: var(--spacing-block);
    list-style: none;
    padding: 0;
  }

  .gl-row {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    row-gap: 1rem;
    padding-block: clamp(1.75rem, 1rem + 2vw, 3rem);
    border-top: 1px solid var(--color-edge);
  }

  .gl-row:last-child {
    border-bottom: 1px solid var(--color-edge);
  }

  /* A short tan fill marks the start of each row. */
  .gl-row::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 3rem;
    height: 3px;
    background: var(--color-accent-fill);
  }

  .gl-value {
    grid-column: 1 / -1;
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    text-transform: var(--display-case);
    font-weight: 850;
    font-size: clamp(1.9rem, 0.9rem + 3.6vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-fg);
    font-variant-numeric: tabular-nums;
    overflow-wrap: break-word;
  }

  .gl-text {
    grid-column: 1 / -1;
  }

  @media (min-width: 64rem) {
    .gl-value {
      grid-column: 1 / span 7;
    }
    .gl-text {
      grid-column: 9 / -1;
      align-self: end;
    }
  }
</style>
