---
/*
  A plain phone: a rounded bezel and a screen the slot fills, for an app
  captured at phone width (the Meal Planner's 420 CSS px captures). Same
  neutral greys and frame shadow as BrowserFrame — no notch, no buttons, no
  colour. The screen keeps the capture's aspect ratio (`ratio`): a first
  screen fills it exactly; a crop from further down a full-page capture
  keeps its own proportions from the top of the screen, and `matte` (the
  app's background colour) fills whatever is left below it.

  The width is set by whoever places it (--phone-w).
*/

interface Props {
  class?: string;
  /** Screen aspect ratio, e.g. "840 / 1840". */
  ratio?: string;
  /** The app's background colour, behind a capture shorter than the screen. */
  matte?: string;
}

const { class: cls, ratio = '840 / 1840', matte } = Astro.props;
const style = [`--phone-ratio: ${ratio}`, matte && `--phone-matte: ${matte}`].filter(Boolean).join('; ');
---

<div class:list={['cs-phone', cls]} style={style}>
  <div class="cs-phone__screen">
    <slot />
  </div>
</div>

<style>
  .cs-phone {
    width: var(--phone-w, 20rem);
    max-width: 100%;
    padding: 0.5rem;
    border: 1px solid var(--color-edge-strong);
    border-radius: 2.25rem;
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-frame);
  }

  .cs-phone__screen {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--phone-ratio);
    border-radius: 1.75rem;
    background: var(--phone-matte, var(--color-surface-sunken));
  }

  /* A crop keeps its own aspect ratio; a first-screen capture fills. */
  .cs-phone__screen > :global(.cs-crop) {
    width: 100%;
  }

  .cs-phone__screen :global(.cs-fill-top) {
    width: 100%;
    height: 100%;
  }
</style>
