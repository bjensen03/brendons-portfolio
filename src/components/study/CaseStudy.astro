<script>
  import { registerMotion } from '../../scripts/motion';
  import {
    studyVideos,
    studyZoom,
    erasStage,
    pageScroller,
    stepViewers,
    hardBeats,
    studyHighlights,
    highlightShapes,
    viewSwitch,
  } from '../../scripts/study-motion';
  import { scrollerMobile, stepSwipe, erasMobile, studyProgress, stripSwipe } from '../../scripts/mobile-motion';

  /* Videos and the step viewers have a job with motion off too (play
     buttons, tabs); they handle reduced motion themselves. */
  /* First, so the right view is in the document before anything else
     measures it (it's a no-op on a study without an overview). */
  registerMotion(viewSwitch, { reduced: true });
  registerMotion(studyVideos, { reduced: true });
  registerMotion(stepViewers, { reduced: true });
  registerMotion(studyZoom);
  registerMotion(erasStage);
  registerMotion(pageScroller, { reduced: true });
  registerMotion(hardBeats);
  registerMotion(studyHighlights);
  registerMotion(highlightShapes, { reduced: true });
  /* Phones and tablets (mobile-motion.ts). The swipes, counters and the
     reading pill work with motion off too; they drop their animation then. */
  registerMotion(scrollerMobile, { reduced: true });
  registerMotion(stepSwipe, { reduced: true });
  registerMotion(erasMobile, { reduced: true });
  registerMotion(studyProgress, { reduced: true });
  /* With reduced motion too: the swipe rows still need to fit their height
     to the piece on screen (the nudge hint skips itself). */
  registerMotion(stripSwipe, { reduced: true });
</script>

