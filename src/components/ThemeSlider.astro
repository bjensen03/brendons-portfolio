---
/*
  Page brightness. Writes --lum on <html> (0 = darkest, 1 = paper); every
  colour token is derived from it in global.css, so this is the whole
  feature on the script side.

  Two renderings of one control:
    rail     fixed on the right edge, vertically centred, ≥1024. Lives in
             Base and is persisted across view transitions.
    compact  a 44px button in the nav below 1024 that opens a strip under
             the bar with a horizontal slider. Lives in the header, so it
             follows the header's tone like everything else in it.

  What it is, at a glance: a sun at the bright end
  and a moon at the dark end of the track, a "Brightness" tooltip on hover
  and focus, and the same word shown once by itself on a first visit
  (remembered in localStorage as bj:lum-hinted). On phones the nav button
  shows a moon or a sun for the current setting, and the strip reads
  "Brightness", moon, slider, sun.

  Both are native range inputs (0–100), so arrows, Page Up/Down, Home and
  End all work and screen readers announce a slider. Arrows move 5,
  Page Up/Down 20. Dragging re-themes live with no transition; keys ease.
*/

interface Props {
  variant: 'rail' | 'compact';
}

const { variant } = Astro.props;
---

{
  variant === 'rail' ? (
    <div class="lum-rail" data-lum-rail transition:persist="lum-rail">
      <span class="lum-end" title="Brighter"><svg class="lum-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg></span>
      <input
        type="range"
        min="0"
        max="100"
        step="1"
        value="0"
        aria-label="Page brightness"
        aria-valuetext="Graphite, 0%"
        title="Brightness"
        class="lum-range lum-range--v"
        data-lum-input
      />
      <span class="lum-end" title="Darker"><svg class="lum-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" /></svg></span>
      <span class="lum-tip lum-tip--rail" aria-hidden="true">Brightness</span>
    </div>
  ) : (
    <div class="lum-compact" data-lum-compact>
      <button
        type="button"
        class="inline-flex min-h-11 min-w-11 items-center justify-center"
        aria-label="Page brightness"
        title="Brightness"
        aria-expanded="false"
        aria-controls="lum-strip"
        data-lum-toggle
      >
        <span class="lum-glyph" aria-hidden="true"><svg class="lum-icon lum-icon--moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" /></svg><svg class="lum-icon lum-icon--sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg></span>
      </button>
      <span class="lum-tip lum-tip--below" aria-hidden="true">Brightness</span>

      <div id="lum-strip" class="lum-strip border-b border-edge bg-surface" hidden data-lum-strip>
        <div class="mx-auto box-content flex max-w-site items-center gap-3 px-(--grid-margin)">
          <span class="lum-strip__label text-small text-fg-muted" aria-hidden="true">Brightness</span>
          <span class="lum-end"><svg class="lum-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" /></svg></span>
          <input
            type="range"
            min="0"
            max="100"
            step="1"
            value="0"
            aria-label="Page brightness"
            aria-valuetext="Graphite, 0%"
            class="lum-range lum-range--h"
            data-lum-input
          />
          <span class="lum-end"><svg class="lum-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg></span>
        </div>
      </div>
    </div>
  )
}

<style>
  /* ── Rail (≥1024) ─────────────────────────────────────────────────────
     32px wide at 8px from the edge, so it sits inside the 48px grid margin
     and never over content. A sun on top, a moon at the bottom and the
     gradient between say what it does; the input carries its name and
     value for assistive tech. The plate keeps the track's ends visible whatever band
     is scrolling behind it. */
  .lum-rail {
    position: fixed;
    top: 50%;
    right: 0.5rem;
    z-index: 40;
    display: none;
    width: 2rem;
    flex-direction: column;
    align-items: center;
    padding-block: 0.625rem;
    border: 1px solid var(--color-edge);
    border-radius: var(--radius-frame);
    background-color: var(--color-surface);
    transform: translateY(-50%);
  }

  @media (min-width: 64rem) {
    :global(html.js) .lum-rail {
      display: flex;
    }
  }

  /* ── Compact (<1024) ──────────────────────────────────────────────────── */
  .lum-compact {
    display: none;
  }

  @media (max-width: 63.999rem) {
    :global(html.js) .lum-compact {
      display: block;
    }
  }

  /* Option A: a sun at the bright end, a moon at the dark end, same
     outline weight as the menu icons. Muted, so they label the track
     without competing with it. */
  .lum-end {
    display: grid;
    place-items: center;
    color: var(--color-fg-muted);
  }
  .lum-rail .lum-end {
    padding-block: 0.25rem;
  }
  .lum-icon {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lum-strip .lum-icon {
    width: 1.15rem;
    height: 1.15rem;
  }
  .lum-glyph .lum-icon {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--color-fg);
  }
  /* The phone button shows where the page is now: a moon on the dark
     range, a sun on the light one (follows data-scheme from the script). */
  .lum-glyph .lum-icon--sun,
  :global(html[data-scheme='light']) .lum-glyph .lum-icon--moon {
    display: none;
  }
  :global(html[data-scheme='light']) .lum-glyph .lum-icon--sun {
    display: block;
  }
  .lum-strip__label {
    flex: none;
  }

  /* The tooltip: plain words above the rail (below the button on phones)
     on hover, on keyboard focus, and once on a first visit. */
  .lum-compact {
    position: relative;
  }
  .lum-tip {
    position: absolute;
    top: 50%;
    right: calc(100% + 0.5rem);
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--color-edge);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    color: var(--color-fg);
    font-size: var(--text-small);
    line-height: 1.3;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(0.25rem, -50%);
    transition:
      opacity var(--duration-fast) var(--ease-out-soft),
      transform var(--duration-fast) var(--ease-out-soft);
  }
  .lum-tip--below {
    top: calc(100% + 0.25rem);
    right: 50%;
    transform: translate(50%, -0.25rem);
  }
  .lum-rail:hover .lum-tip,
  .lum-rail:focus-within .lum-tip,
  :global(html.lum-hint) .lum-tip {
    opacity: 1;
    transform: translate(0, -50%);
  }
  :global(html.lum-hint) .lum-tip--below,
  .lum-compact:hover .lum-tip--below {
    opacity: 1;
    transform: translate(50%, 0);
  }
  /* Desktop: the label stands upright in the rail's own column, just above
     the sun, reading bottom to top. The rail sits in the page's right
     margin, so the label never covers page text (beside the rail it sat
     on the full stop of "BRENDON."). 27px wide inside the 32px
     column. Fades and settles down onto the rail. */
  .lum-tip--rail {
    top: auto;
    right: auto;
    bottom: calc(100% + 0.375rem);
    left: 50%;
    padding: 0.6rem 0.2rem;
    writing-mode: vertical-rl;
    transform: translate(-50%, -0.25rem) rotate(180deg);
  }
  .lum-rail:hover .lum-tip--rail,
  .lum-rail:focus-within .lum-tip--rail,
  :global(html.lum-hint) .lum-tip--rail {
    transform: translate(-50%, 0) rotate(180deg);
  }

  /* Phones and tablets: the first-visit label hangs from the bottom edge
     of the bar like a tab, centred under the button, instead of
     floating a line lower where it sat on the top of the page's
     headline. It ends ~24px below the bar, clear of every hero's first
     line. Fades only; no slide. */
  @media (max-width: 63.999rem) {
    .lum-tip--below {
      /* The 44px button is centred in the bar, so the bar's bottom edge is
         half the leftover height below it. Centred under the moon. */
      top: calc(100% + (var(--spacing-nav) - 2.75rem) / 2);
      padding: 0.2rem 0.6rem 0.3rem;
      border-top: 0;
      border-radius: 0 0 var(--radius-control) var(--radius-control);
      font-size: 0.8125rem;
      transform: translateX(50%);
    }
    :global(html.lum-hint) .lum-tip--below,
    .lum-compact:hover .lum-tip--below {
      transform: translateX(50%);
    }
  }
  /* Narrow phones: the moon and sun at the ends say what the strip does;
     the word took ~80px of the track. */
  @media (max-width: 24.999rem) {
    .lum-strip__label {
      display: none;
    }
  }
  /* Not while the strip is open: it has its own label. */
  .lum-compact:has([aria-expanded='true']) .lum-tip--below {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .lum-tip {
      transition: none;
    }
  }

  /* Full width under the bar, like the menu sheet. */
  .lum-strip {
    position: fixed;
    inset-inline: 0;
    top: var(--spacing-nav);
    border-top: 1px solid var(--color-edge);
    padding-block: 0.5rem;
  }

  /* ── The range input ───────────────────────────────────────────────────
     Track is the greyscale sweep; the thumb is filled with the current
     surface and ringed in ink, so it reads as "this is your page". Track
     and thumb sizes are vars so hover/focus can grow both. */
  .lum-range {
    --track: 6px;
    --thumb: 16px;
    appearance: none;
    margin: 0;
    background: transparent;
    cursor: pointer;
    touch-action: none;
  }

  .lum-range--v {
    writing-mode: vertical-lr;
    direction: rtl;
    inline-size: 11rem;
    block-size: 1.5rem;
  }

  .lum-range--h {
    --track: 8px;
    --thumb: 24px;
    flex: 1;
    min-width: 0;
    block-size: 2.75rem;
  }

  .lum-rail:hover .lum-range,
  .lum-range:focus-visible {
    --track: 8px;
    --thumb: 20px;
  }

  .lum-range--h:focus-visible {
    --track: 10px;
    --thumb: 26px;
  }

  /* A fingertip covers a 24px thumb; on touch it's bigger, so you can see
     the ring you're dragging. */
  @media (pointer: coarse) {
    .lum-range--h {
      --track: 10px;
      --thumb: 30px;
    }
  }

  /* The ring goes on the thumb, not round the whole box. */
  .lum-range:focus-visible {
    outline: none;
  }

  .lum-range::-webkit-slider-runnable-track {
    block-size: var(--track);
    border-radius: var(--track);
    background: linear-gradient(to top, var(--gradient-lum));
    box-shadow: inset 0 0 0 1px var(--color-edge-strong);
    transition: block-size var(--duration-fast) var(--ease-out-soft);
  }

  .lum-range--h::-webkit-slider-runnable-track {
    background: linear-gradient(to right, var(--gradient-lum));
  }

  .lum-range::-webkit-slider-thumb {
    appearance: none;
    inline-size: var(--thumb);
    block-size: var(--thumb);
    margin-block-start: calc((var(--track) - var(--thumb)) / 2);
    border: 2px solid var(--color-fg);
    border-radius: 50%;
    background-color: var(--color-surface);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-surface) 70%, transparent);
    transition:
      inline-size var(--duration-fast) var(--ease-out-soft),
      block-size var(--duration-fast) var(--ease-out-soft),
      margin var(--duration-fast) var(--ease-out-soft);
  }

  .lum-range:focus-visible::-webkit-slider-thumb {
    box-shadow:
      0 0 0 2px var(--color-surface),
      0 0 0 4px var(--color-focus);
  }

  .lum-range::-moz-range-track {
    block-size: var(--track);
    border-radius: var(--track);
    background: linear-gradient(to top, var(--gradient-lum));
    box-shadow: inset 0 0 0 1px var(--color-edge-strong);
  }

  .lum-range--h::-moz-range-track {
    background: linear-gradient(to right, var(--gradient-lum));
  }

  .lum-range::-moz-range-thumb {
    box-sizing: border-box;
    inline-size: var(--thumb);
    block-size: var(--thumb);
    border: 2px solid var(--color-fg);
    border-radius: 50%;
    background-color: var(--color-surface);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-surface) 70%, transparent);
  }

  .lum-range:focus-visible::-moz-range-thumb {
    box-shadow:
      0 0 0 2px var(--color-surface),
      0 0 0 4px var(--color-focus);
  }
</style>

<script>
  const KEY = 'bj:lum';
  const DEFAULT = 0;
  const root = document.documentElement;

  type LumWindow = Window & { __bjLum?: number };
  const w = window as LumWindow;

  const nameFor = (pct: number) =>
    pct < 25 ? 'Graphite' : pct < 50 ? 'Light graphite' : pct < 75 ? 'Deep sand' : 'Sand';

  const current = (): number => {
    if (typeof w.__bjLum === 'number') return w.__bjLum;
    try {
      const n = parseFloat(localStorage.getItem(KEY) ?? '');
      if (n >= 0 && n <= 1) return n;
    } catch {
      /* Storage blocked: the default stands. */
    }
    return DEFAULT;
  };

  const inputs = () => document.querySelectorAll<HTMLInputElement>('[data-lum-input]');

  const sync = (lum: number) => {
    const pct = Math.round(lum * 100);
    inputs().forEach((input) => {
      if (input.valueAsNumber !== pct) input.value = String(pct);
      input.setAttribute('aria-valuetext', `${nameFor(pct)}, ${pct}%`);
    });
  };

  const apply = (lum: number) => {
    w.__bjLum = lum;
    root.style.setProperty('--lum', String(lum));
    root.dataset.scheme = lum >= 0.5 ? 'light' : 'dark';
    sync(lum);
    try {
      localStorage.setItem(KEY, String(lum));
    } catch {
      /* Works for this visit without storage. */
    }
  };

  const STEP: Record<string, number> = {
    ArrowUp: 5,
    ArrowRight: 5,
    ArrowDown: -5,
    ArrowLeft: -5,
    PageUp: 20,
    PageDown: -20,
  };

  /* Dragging: no --lum transition, so the page follows the thumb exactly. */
  const endScrub = () => root.classList.remove('lum-scrub');
  window.addEventListener('pointerup', endScrub);
  window.addEventListener('pointercancel', endScrub);

  const bind = (input: HTMLInputElement) => {
    if (input.dataset.lumReady === 'true') return;
    input.dataset.lumReady = 'true';
    input.addEventListener('pointerdown', () => root.classList.add('lum-scrub'));
    input.addEventListener('input', () => apply(input.valueAsNumber / 100));
    input.addEventListener('keydown', (event) => {
      const step = STEP[event.key];
      if (step === undefined) return;
      event.preventDefault();
      endScrub();
      const next = Math.min(100, Math.max(0, input.valueAsNumber + step));
      apply(next / 100);
    });
  };

  /* Compact: the button opens the strip under the bar. */
  const compact = () => ({
    toggle: document.querySelector<HTMLButtonElement>('[data-lum-toggle]'),
    strip: document.querySelector<HTMLElement>('[data-lum-strip]'),
  });

  const setStrip = (open: boolean, returnFocus = false) => {
    const { toggle, strip } = compact();
    if (!toggle || !strip) return;
    toggle.setAttribute('aria-expanded', String(open));
    strip.hidden = !open;
    if (open) strip.querySelector<HTMLInputElement>('[data-lum-input]')?.focus();
    else if (returnFocus) toggle.focus();
  };

  const isStripOpen = () => compact().toggle?.getAttribute('aria-expanded') === 'true';

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isStripOpen()) {
      event.preventDefault();
      setStrip(false, true);
    }
  });

  document.addEventListener('pointerdown', (event) => {
    if (!isStripOpen()) return;
    const target = event.target as HTMLElement;
    if (!target.closest('[data-lum-compact]')) setStrip(false);
  });

  /* The menu and the strip share the space under the bar: one at a time. */
  document.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('[data-nav-toggle]') && isStripOpen()) setStrip(false);
  });

  window.matchMedia('(min-width: 64rem)').addEventListener('change', (mq) => {
    if (mq.matches && isStripOpen()) setStrip(false);
  });

  const setup = () => {
    inputs().forEach(bind);
    sync(current());
    const { toggle } = compact();
    if (toggle && toggle.dataset.lumReady !== 'true') {
      toggle.dataset.lumReady = 'true';
      toggle.addEventListener('click', () => {
        const open = !isStripOpen();
        if (open) {
          /* Close the menu sheet if it's up. */
          const menu = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
          if (menu?.getAttribute('aria-expanded') === 'true') menu.click();
        }
        setStrip(open);
      });
    }
  };

  /* First visit only: the "Brightness" label shows for four seconds, a
     moment after the page settles, then never again (remembered in
     localStorage; if storage is blocked it just shows once per page load). */
  const HINT_KEY = 'bj:lum-hinted';
  const hint = () => {
    try {
      if (localStorage.getItem(HINT_KEY)) return;
      localStorage.setItem(HINT_KEY, '1');
    } catch {
      /* No storage: show it this once. */
    }
    window.setTimeout(() => {
      root.classList.add('lum-hint');
      window.setTimeout(() => root.classList.remove('lum-hint'), 4000);
    }, 1500);
  };

  setup();
  hint();
  document.addEventListener('astro:page-load', setup);
</script>
