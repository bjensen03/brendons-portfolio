---
import Section from './Section.astro';
import { CONTACT } from '../config';

/*
  Closing call to action.

  The email is a real mailto rather than only a form link — plenty of people
  would rather write an email than fill in three fields, and making them click
  through to a contact page first loses some of them.
*/
---

<Section surface="sunken" width="wide" revealGroup>
  <div class="grid gap-10 md:grid-cols-[1.2fr_0.8fr] md:items-end">
    <div>
      <h2
        class="font-display text-5xl leading-[0.9] uppercase md:text-7xl"
        style="letter-spacing: var(--tracking-display);"
        data-split
      >
        Got something<br />that needs building?
      </h2>

      <p class="mt-8 max-w-measure font-body text-lg text-fg-muted" data-reveal>
        Contract work, a stuck project, or a site that has stopped earning its keep. Tell me
        what it needs to do and I'll tell you honestly whether I'm the right person.
      </p>
    </div>

    <div class="flex flex-col items-start gap-5 md:items-end" data-reveal>
      <a
        href={`mailto:${CONTACT.email}`}
        class="transition-soft font-display text-2xl text-fg-bright hover:text-signal md:text-3xl"
        style="letter-spacing: var(--tracking-display);"
      >
        {CONTACT.email}
      </a>

      <a
        href="/contact/"
        class="transition-soft inline-flex items-center rounded-full bg-signal px-7 py-3.5 font-body text-sm text-surface hover:bg-signal-bright"
        data-magnetic="0.25"
      >
        Or use the form
      </a>
    </div>
  </div>
</Section>
