---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
import '../styles/global.css';
/* Imported after global.css so the direction blocks win the cascade. */
import '../styles/directions.css';

interface Props {
  title?: string;
  description?: string;
  /** Page-specific social image. Per-study OG images land in Phase 6. */
  ogImage?: string;
  /** Prototype design direction. Omit for the base palette. */
  direction?: 'slot' | 'topo' | 'beta';
  /** Drop the site chrome — used by the full-bleed direction prototypes. */
  bare?: boolean;
}

const { title, description = SITE.description, ogImage, direction, bare = false } = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
const ogUrl = ogImage ? new URL(ogImage, Astro.site ?? SITE.url) : undefined;
---

<!doctype html>
<html lang="en" data-direction={direction}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />
    {ogUrl && <meta property="og:image" content={ogUrl.href} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      /* Astro emits the @font-face rules, the metric-matched fallbacks and the
         preload links. Only the display face of the active direction is
         preloaded — preloading all three would waste bandwidth on two fonts the
         page never paints. */
    }
    <Font cssVariable="--font-grotesk" preload />
    {direction === 'topo' && <Font cssVariable="--font-bricolage" preload />}
    {direction !== 'topo' && <Font cssVariable="--font-condensed" preload />}

    <ClientRouter />

    <script is:inline>
      /*
        Runs before first paint. Two jobs:

        1. Add .motion-ok so elements that animate in can start hidden without
           a flash of content. Reduced-motion users never get the class, so
           their content is visible from the first frame.

        2. Arm a failsafe. If the motion module fails to load — a bad deploy, a
           blocked bundle, an error in a dependency — nothing would ever remove
           the hidden state and the page would render blank. The timeout
           guarantees content appears regardless. initMotion() disarms it.
      */
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('motion-ok');
        window.__motionFailsafe = window.setTimeout(function () {
          document.documentElement.classList.remove('motion-ok');
        }, 3000);
      })();
    </script>
  </head>

  <body class="min-h-screen">
    <a href="#main" class="skip-link bg-surface-raised px-4 py-3 text-sm text-fg-bright">
      Skip to content
    </a>

    {!bare && <Nav />}

    <main id="main">
      <slot />
    </main>

    {!bare && <Footer />}

    <script>
      import { initMotion } from '../scripts/motion';

      initMotion();
    </script>
  </body>
</html>
